# apps/agent in the compose full stack. Non-secret dev placeholders only (see README.md).
# development, not production: INKLING_AGENT_MODEL=scripted is refused in production.
INKLING_ENV=development
INKLING_AGENT_HOST=0.0.0.0
INKLING_AGENT_PORT=8100
INKLING_AGENT_MODEL=scripted
INKLING_AGENT_SANDBOX=off
INKLING_AGENT_STORE=postgres
INKLING_AGENT_DATABASE_URL=postgres://studio:dev-only-pg-password@postgres:5432/agent
INKLING_AGENT_AUTO_MIGRATE=true
INKLING_AGENT_EVENT_BUS=redis
INKLING_AGENT_REDIS_URL=redis://redis:6379/1
INKLING_AGENT_SWEEPER_ENABLED=false
INKLING_API_URL=http://api:8000
INKLING_WEB_URL=http://router:8080
INKLING_AGENT_DATA_DIR=/tmp/agent
INKLING_AGENT_TOKEN=dev-only-agent-service-token

# Non-secret settings for apps/agent. Keys live in ../../secrets/*.env (dev) or the real environment.
INKLING_ENV=development
INKLING_AGENT_HOST=127.0.0.1
INKLING_AGENT_PORT=8100

# provider:model-id, must be in INKLING_AGENT_MODEL_ALLOWLIST
INKLING_AGENT_MODEL=openai:gpt-6.1-sol
INKLING_AGENT_MODEL_ALLOWLIST=openai:gpt-6.1-sol,openai:gpt-6-sol,anthropic:claude-sonnet-5-5,anthropic:claude-opus-5-5
INKLING_AGENT_THINKING=low

# Daytona sandbox lifecycle (minutes)
INKLING_AGENT_SANDBOX_AUTO_STOP_MIN=15
INKLING_AGENT_SANDBOX_AUTO_ARCHIVE_MIN=1440
INKLING_AGENT_SANDBOX_AUTO_DELETE_MIN=10080
INKLING_AGENT_SANDBOX_TTL_MIN=1440
# Empty = build/use the content-hashed inkling-agent-<hash> snapshot; "default" = Daytona's default image
INKLING_AGENT_SANDBOX_SNAPSHOT=

# Budgets per run
INKLING_AGENT_MAX_TOOL_CALLS=80
INKLING_AGENT_MAX_RUN_SECONDS=900
INKLING_AGENT_MAX_SPEND_USD=2
INKLING_AGENT_EXEC_TIMEOUT_S=300
INKLING_AGENT_TOOL_OUTPUT_MAX=65536
INKLING_AGENT_CLIENT_TOOL_TIMEOUT_S=120
INKLING_AGENT_APPROVAL_TIMEOUT_S=600

# Concurrency
INKLING_AGENT_MAX_SESSIONS=50
INKLING_AGENT_MAX_CONCURRENT_RUNS=2

# Sandboxes: `off` disables them even when DAYTONA_API_KEY is set
INKLING_AGENT_SANDBOX=daytona
INKLING_AGENT_SANDBOX_IDLE_STOP_MIN=30
INKLING_AGENT_SANDBOX_RETENTION_DAYS=7
# `auto`: probe once (cached a day) whether this Daytona org may set egress rules (tier 3+)
INKLING_AGENT_EGRESS_PROBE=auto
INKLING_AGENT_UPLOAD_MAX_FILES=20
INKLING_AGENT_UPLOAD_MAX_MB=200

# The Studio (Vite dev server): seed API fallback and sample uploads
INKLING_WEB_URL=http://localhost:5173

# The kernel (apps/api) for the builder and task profiles. The Studio mints the session's kernel
# token (POST /api/v1/sessions) and passes it with each message; nothing here holds credentials.
INKLING_API_URL=http://127.0.0.1:8000
# Optional overrides when the repo isn't next to the service (deployed image):
# NAMING_FILE=/etc/agent/naming.json          # schemas/naming.json
# INKLING_AGENT_PLUGIN_TEMPLATE_DIR=/srv/plugins/_template  # scaffold for create_plugin_sandbox

# INKLING_AGENT_MODEL=scripted replays INKLING_AGENT_SCRIPT (JSON) instead of calling a provider (dev/test only)
# INKLING_AGENT_SCRIPT=../../tests/e2e/fixtures/agent-script.json
# INKLING_AGENT_DATA_DIR=.data
INKLING_LOG_LEVEL=info

# State backends (README "Scaling"). Defaults are for one dev process; replicas > 1 need postgres + redis.
INKLING_AGENT_STORE=file
# INKLING_AGENT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent
# INKLING_AGENT_DATABASE_SCHEMA=public
# INKLING_AGENT_AUTO_MIGRATE=1
INKLING_AGENT_EVENT_BUS=memory
# INKLING_AGENT_REDIS_URL=redis://127.0.0.1:6379
INKLING_AGENT_RUN_STREAM_MAXLEN=5000
INKLING_AGENT_RUN_STREAM_TTL_S=86400
INKLING_AGENT_RUN_LEASE_S=30
INKLING_AGENT_RUN_HEARTBEAT_S=10
INKLING_AGENT_INBOX_POLL_MS=1000
# INKLING_AGENT_REPLICA_ID=
INKLING_AGENT_SHUTDOWN_GRACE_S=100
INKLING_AGENT_SWEEPER_ENABLED=true
# GIT_SHA=
# OTEL_EXPORTER_OTLP_ENDPOINT=

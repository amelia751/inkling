{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@studio/agent-protocol": [
        "../../packages/agent-protocol/src/index.ts"
      ],
      "@studio/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@studio/environment-core": [
        "../../packages/environment-core/src/index.ts"
      ],
      "@studio/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@studio/plugin-ui-sdk": [
        "../../packages/plugin-ui-sdk/src/index.ts"
      ],
      "@studio/plugin-ui-sdk/*": [
        "../../packages/plugin-ui-sdk/src/*"
      ],
      "@studio/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@studio/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@studio/studio-tools/*": [
        "../../packages/studio-tools/src/*"
      ],
      "@studio/renderers": [
        "../../packages/renderers/src/index.ts"
      ],
      "@studio/renderers/*": [
        "../../packages/renderers/src/*"
      ],
      "@plugins/_template/*": [
        "../../plugins/_template/ui/*"
      ],
      "@plugins/image2d/*": [
        "../../plugins/image2d/ui/*"
      ],
      "@plugins/volume/*": [
        "../../plugins/volume/ui/*"
      ],
      "@plugins/timeseries/*": [
        "../../plugins/timeseries/ui/*"
      ],
      "@plugins/video/*": [
        "../../plugins/video/ui/*"
      ],
      "@plugins/cine/*": [
        "../../plugins/cine/ui/*"
      ],
      "@plugins/cardiac-metrics/*": [
        "../../plugins/cardiac-metrics/ui/*"
      ],
      "@plugins/wsi/*": [
        "../../plugins/wsi/ui/*"
      ],
      "@plugins/text-spans/*": [
        "../../plugins/text-spans/ui/*"
      ],
      "@plugins/table/*": [
        "../../plugins/table/ui/*"
      ],
      "@plugins/dicom-export/*": [
        "../../plugins/dicom-export/ui/*"
      ]
    }
  },
  "include": [
    "src",
    "dev",
    "vite.config.ts",
    "vitest.config.ts",
    "aliases.ts",
    "../../packages/agent-protocol/src",
    "../../packages/contracts/src",
    "../../packages/plugin-ui-sdk/src",
    "../../packages/ui/src",
    "../../packages/renderers/src",
    "../../plugins/*/ui",
    "vitest.setup.ts"
  ]
}

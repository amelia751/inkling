# apps/api in the compose full stack. Non-secret dev placeholders only (see README.md).
INKLING_ENV=production
INKLING_API_DATABASE_URL=postgresql+psycopg://studio:dev-only-pg-password@postgres:5432/studio
INKLING_API_CREATE_TABLES=0
INKLING_API_SECRET_KEY=dev-only-api-secret-key-not-for-production-0000
INKLING_API_WORKER_TOKEN=dev-only-worker-token
INKLING_API_DEV_TRUST_HEADERS=1
INKLING_REDIS_URL=redis://redis:6379/0
INKLING_JOB_QUEUE=redis
INKLING_EVENT_BUS=redis
INKLING_BLOB_STORE=s3
INKLING_S3_ENDPOINT=http://s3:9000
INKLING_S3_BUCKET=assets
INKLING_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev-only-s3-access
AWS_SECRET_ACCESS_KEY=dev-only-s3-secret
INKLING_API_VERSIONING_URL=http://versioning:8090
INKLING_API_VERSIONING_JWT_KEY_FILE=/keys/jwt.key
INKLING_API_VERSIONING_JWKS_FILE=/keys/jwks.json
INKLING_API_VERSIONING_JWT_KID=dev

# Rendered at container start by the nginx image's envsubst step into /tmp/nginx/conf.d.
# Only ${VAR}s defined in the environment are substituted (Dockerfile ENV sets defaults):
#   INKLING_AGENT_URL              the agent service (default http://agent:8100); a name the
#                                  resolver can answer without search domains (k8s: the FQDN)
#   NGINX_LOCAL_RESOLVERS          the nameservers in /etc/resolv.conf (set by the image's
#                                  entrypoint, NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1)
#   INKLING_AGENT_TOKEN            service token the proxy adds; it never reaches the browser
#   INKLING_WEB_AUTH_MODE          `dev` (default) or `workos`: picks agent-auth/<mode>.inc (todo9 Phase 5)
#   INKLING_API_URL                the API (default http://api:8000); `workos` mode asks its
#                                  /api/auth/verify for the person's access token
#   GIT_SHA                        build revision for /version
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Re-resolve the agent's name every 10 s and spread requests over every address it returns,
  # so replicas added after nginx started get traffic (compose `--scale agent=N`). In
  # Kubernetes the name is the Service's one ClusterIP either way.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  resolver_timeout 3s;

  # Probes (unauthenticated, not logged).
  location = /healthz { access_log off; default_type application/json; return 200 '{"status":"ok"}'; }
  location = /readyz  { access_log off; default_type application/json; return 200 '{"status":"ok"}'; }
  location = /version { access_log off; default_type application/json; return 200 '{"service":"web","gitSha":"${GIT_SHA}"}'; }

  # Runtime config (ConfigMap / compose volume at /etc/studio/config.json). Missing → 404 and
  # the SPA uses same-origin defaults. Never cached.
  location = /config.json {
    root /etc/studio;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    try_files /config.json =404;
  }

  # workos mode: auth_request subrequest. The API reads the session cookie and answers 200 with
  # `X-Access-Token: <WorkOS access token>` (refreshed if needed) or 401. Never routed from outside.
  location = /_auth {
    internal;
    set $api_upstream ${INKLING_API_URL};
    proxy_pass $api_upstream/api/auth/verify;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Request-Id $request_id;
  }

  # The agent service: /api/agent/* → <agent>/v1/* with the service token (what the Vite
  # proxy does in dev). agent-auth/<mode>.inc sets the identity headers: `dev` sends the service
  # token as the bearer (and in X-Agent-Service-Token), `workos` forwards the person's access
  # token as the bearer and the service token in X-Agent-Service-Token only.
  # SSE run streams: no buffering, no compression, hour-long timeouts.
  location /api/agent/ {
    include /tmp/nginx/conf.d/agent-auth/${INKLING_WEB_AUTH_MODE}.inc;
    set $agent_upstream ${INKLING_AGENT_URL};
    rewrite ^/api/agent/(.*)$ /v1/$1 break;
    proxy_pass $agent_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_request_buffering off;
    gzip off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 200m;
  }

  # Hashed build assets: cache forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # MCP Apps sandbox proxy (todo10 Phase 5): no network for anything it loads. Same CSP as
  # SANDBOX_PROXY_CSP in vite.config.ts. Point the runtime config's `sandboxOrigin` at a second
  # host name served by this block, so the proxy is on a separate origin from the Studio.
  location = /sandbox-proxy.html {
    add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' blob:; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'" always;
    add_header Cache-Control "no-cache" always;
    try_files /sandbox-proxy.html =404;
  }

  # SPA fallback; index.html is revalidated so a deploy shows up on reload.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}

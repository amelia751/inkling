{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineApprovalRequest",
  "$defs": {
    "PipelineApprovalRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "approval_id",
        "candidate_digest"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/pipeline/approval.v1"
}

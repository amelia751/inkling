# Non-secret settings for apps/agent. Keys live in ../../secrets/*.env (dev) or the real environment.
APP_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8100

# provider:model-id, must be in AGENT_MODEL_ALLOWLIST
AGENT_MODEL=openai:gpt-6.1-sol
AGENT_MODEL_ALLOWLIST=openai:gpt-6.1-sol,openai:gpt-6-sol,anthropic:claude-sonnet-5-5,anthropic:claude-opus-5-5
AGENT_THINKING=low

# Daytona sandbox lifecycle (minutes)
AGENT_SANDBOX_AUTO_STOP_MIN=15
AGENT_SANDBOX_AUTO_ARCHIVE_MIN=1440
AGENT_SANDBOX_AUTO_DELETE_MIN=10080
AGENT_SANDBOX_TTL_MIN=1440
# Empty = build/use the content-hashed inkling-agent-<hash> snapshot; "default" = Daytona's default image
AGENT_SANDBOX_SNAPSHOT=

# Budgets per run
AGENT_MAX_TOOL_CALLS=80
AGENT_MAX_RUN_SECONDS=900
AGENT_MAX_SPEND_USD=2
AGENT_EXEC_TIMEOUT_S=300
AGENT_TOOL_OUTPUT_MAX=65536
AGENT_CLIENT_TOOL_TIMEOUT_S=120

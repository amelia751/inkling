{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoundaryFilteredAnnotations",
  "$defs": {
    "BoundaryFilteredAnnotations": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "boundary.annotations/v1"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "<20"
            }
          ]
        },
        "annotations": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "itemId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9_./@()+=-]+$"
                  },
                  {
                    "type": "string",
                    "pattern": "^<redacted:\\d{1,5}>$"
                  }
                ]
              },
              "label": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
                          },
                          {
                            "type": "string",
                            "pattern": "^<redacted:\\d{1,5}>$"
                          }
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9 _.:/()-]{1,64}$"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geometry": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provenance": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z-]{1,32}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "review": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z_-]{1,32}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "attributes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9 _.:/()-]{1,64}$"
                    },
                    {
                      "type": "string",
                      "pattern": "^<redacted:\\d{1,5}>$"
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "itemId",
              "label",
              "geometry",
              "provenance",
              "review",
              "attributes"
            ],
            "additionalProperties": false
          }
        },
        "redacted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema",
        "total",
        "annotations",
        "redacted"
      ],
      "additionalProperties": false
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "inkling://schema/boundary/annotations.v1"
}

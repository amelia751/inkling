{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineCancelRunRequest",
  "$defs": {
    "PipelineCancelRunRequest": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false
    }
  },
  "$id": "inkling://schema/pipeline/cancel-run.v1"
}

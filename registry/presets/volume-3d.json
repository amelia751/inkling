{
  "id": "volume-3d",
  "title": "3D volume",
  "description": "MRI / CT volumes in linked MPR with crosshairs, 3D labelmaps, measurements; NIfTI and DICOM export.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "volume-3d",
    "title": "3D volume",
    "data": {
      "kind": "studio.volume.dataKinds.volume"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.volume.renderers.cornerstone-mpr"
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.core.tools.pan",
      "studio.cornerstone.tools.zoom",
      "studio.core.tools.windowLevel",
      "studio.cornerstone.tools.crosshairs",
      "studio.cornerstone.tools.brush",
      "studio.cornerstone.tools.eraser",
      "studio.cornerstone.tools.wand",
      "studio.volume.tools.point",
      "studio.cornerstone.tools.length",
      "studio.cornerstone.tools.angle",
      "studio.cornerstone.tools.bidirectional",
      "studio.cornerstone.tools.ellipse",
      "studio.cornerstone.tools.box",
      "studio.cornerstone.tools.polygon",
      "studio.cornerstone.tools.freehand",
      "studio.cornerstone.tools.probe",
      "studio.cornerstone.tools.arrow"
    ],
    "exporters": [
      "studio.volume.exporters.nifti-labelmap",
      "studio.volume.exporters.masks-json",
      "studio.dicom-export.exporters.dicom-seg",
      "studio.dicom-export.exporters.dicom-sr"
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.core.panels.ai"
      ]
    },
    "reviewRules": [
      "studio.core.reviewRules.source-label-disagreement",
      "studio.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "liver",
        "name": "Liver",
        "synonyms": [
          "hepar"
        ],
        "colour": "#a16207",
        "allowedGeometries": [
          "mask",
          "polygon"
        ]
      },
      {
        "id": "tumor",
        "name": "Tumour",
        "synonyms": [
          "tumor",
          "lesion",
          "neoplasm"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "mask",
          "polygon",
          "box"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "modality",
        "license",
        "source"
      ],
      "oneModalityPerDataset": true,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {
        "dicom.series-incomplete": "warn",
        "dicom.seg-frame-mismatch": "error",
        "nifti.orientation-mismatch": "warn"
      }
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

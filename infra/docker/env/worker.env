# apps/worker in the compose full stack. Non-secret dev placeholders only (see README.md).
INKLING_API_URL=http://api:8000
INKLING_API_WORKER_TOKEN=dev-only-worker-token
INKLING_WORKER_DATA_DIR=/tmp/worker

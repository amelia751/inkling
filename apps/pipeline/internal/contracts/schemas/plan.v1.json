{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineExecutionPlan",
  "$defs": {
    "PipelineExecutionPlan": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "pipeline.plan/v1"
        },
        "definition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PipelineInput"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PipelinePlannedStep"
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\$\\{inputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\$\\{steps\\.[a-z][a-z0-9_-]{0,62}\\.outputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "upload_session",
                  "item_set",
                  "artifact_set",
                  "report",
                  "dataset_commit",
                  "candidate_commit"
                ]
              }
            },
            "required": [
              "ref",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "policy": {
          "$ref": "#/$defs/PipelinePolicy"
        },
        "limits": {
          "$ref": "#/$defs/PipelineLimits"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "definition_digest",
        "name",
        "inputs",
        "order",
        "steps",
        "outputs",
        "policy",
        "limits",
        "digest"
      ],
      "additionalProperties": false
    },
    "PipelineInput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "upload_session",
            "dataset",
            "artifact_set"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "selector": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "maxLength": 128
            },
            "branch": {
              "type": "string",
              "maxLength": 255
            }
          },
          "additionalProperties": false
        },
        "pin_at_run_start": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PipelinePlannedStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "uses": {
          "type": "string",
          "maxLength": 160
        },
        "resolved": {
          "$ref": "#/$defs/PipelineResolvedStep"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "builtin",
            "kernel_job"
          ]
        },
        "job_kind": {
          "type": "string",
          "maxLength": 64
        },
        "plugin": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "resource_class": {
          "type": "string",
          "enum": [
            "cpu",
            "memory",
            "gpu"
          ]
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          }
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\$\\{inputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\$\\{steps\\.[a-z][a-z0-9_-]{0,62}\\.outputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "upload_session",
                  "item_set",
                  "artifact_set",
                  "report",
                  "dataset_commit",
                  "candidate_commit"
                ]
              }
            },
            "required": [
              "ref",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "upload_session",
              "item_set",
              "artifact_set",
              "report",
              "dataset_commit",
              "candidate_commit"
            ]
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "params_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fan_out": {
          "type": "object",
          "properties": {
            "over": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\$\\{inputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                },
                {
                  "type": "string",
                  "pattern": "^\\$\\{steps\\.[a-z][a-z0-9_-]{0,62}\\.outputs\\.[a-z][a-z0-9_]{0,62}\\}$"
                }
              ]
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_partitions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "over",
            "batch_size",
            "max_partitions"
          ],
          "additionalProperties": false
        },
        "optional": {
          "type": "boolean"
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "fail",
            "skip",
            "quarantine"
          ]
        }
      },
      "required": [
        "id",
        "uses",
        "resolved",
        "runtime",
        "resource_class",
        "needs",
        "level",
        "inputs",
        "outputs",
        "params",
        "params_digest",
        "timeout_seconds",
        "max_attempts",
        "optional",
        "on_failure"
      ],
      "additionalProperties": false
    },
    "PipelineResolvedStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "signer"
      ],
      "additionalProperties": false
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "PipelinePolicy": {
      "type": "object",
      "properties": {
        "review": {
          "default": "required",
          "type": "string",
          "enum": [
            "required",
            "auto"
          ]
        },
        "partial_success": {
          "default": {
            "allowed": false,
            "min_success_ratio": 1
          },
          "type": "object",
          "properties": {
            "allowed": {
              "default": false,
              "type": "boolean"
            },
            "min_success_ratio": {
              "default": 1,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "deadline_seconds": {
          "default": 86400,
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "compatibility": {
          "default": "compatible",
          "type": "string",
          "enum": [
            "strict",
            "compatible",
            "adaptive"
          ]
        }
      },
      "additionalProperties": false
    },
    "PipelineLimits": {
      "type": "object",
      "properties": {
        "max_steps": {
          "default": 64,
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_partitions_per_step": {
          "default": 1000,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_total_partitions": {
          "default": 10000,
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "inkling://schema/pipeline/plan.v1"
}

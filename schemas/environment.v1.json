{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EnvironmentSpec",
  "$defs": {
    "EnvironmentSpec": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extends": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "preset:ner",
                "preset:cine-4d",
                "preset:drone-video-tracks",
                "preset:ecg",
                "preset:generic-image",
                "preset:image-2d",
                "preset:pathology",
                "preset:satellite-tiles",
                "preset:sensor-timeseries-events",
                "preset:series-chart",
                "preset:table-review",
                "preset:video",
                "preset:volume-3d"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "preset:ner",
                  "preset:cine-4d",
                  "preset:drone-video-tracks",
                  "preset:ecg",
                  "preset:generic-image",
                  "preset:image-2d",
                  "preset:pathology",
                  "preset:satellite-tiles",
                  "preset:sensor-timeseries-events",
                  "preset:series-chart",
                  "preset:table-review",
                  "preset:video",
                  "preset:volume-3d"
                ]
              }
            }
          ],
          "description": "Preset id(s), e.g. preset:pathology, deep-merged first"
        },
        "task": {
          "description": "Free-form task name shown on dataset cards (classification, segmentation…)",
          "type": "string"
        },
        "modules": {
          "description": "Module id → semver range",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "studio.core",
              "studio.overlay2d",
              "studio.cornerstone",
              "studio.timeline",
              "studio.file-view",
              "studio.generic",
              "studio.image2d",
              "studio.volume",
              "studio.timeseries",
              "studio.video",
              "studio.cine",
              "studio.cardiac-metrics",
              "studio.wsi",
              "studio.dicom-export",
              "studio.text-spans",
              "studio.table",
              "studio.chart",
              "studio.segmentation",
              "studio.presets"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "studio.generic.dataKinds.files",
                "studio.image2d.dataKinds.raster",
                "studio.volume.dataKinds.volume",
                "studio.timeseries.dataKinds.multichannel-timeseries",
                "studio.video.dataKinds.video",
                "studio.cine.dataKinds.volume-time",
                "studio.wsi.dataKinds.raster-pyramid",
                "studio.text-spans.dataKinds.text",
                "studio.table.dataKinds.table",
                "studio.chart.dataKinds.series"
              ],
              "description": "Data kind contribution id"
            },
            "kinds": {
              "description": "Data kind id → its profile (todo19 D3). The active item's kind picks the profile",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/KindProfile"
              }
            }
          },
          "additionalProperties": false
        },
        "accepts": {
          "description": "Data kind ids this Studio's task accepts (todo19 D2); unset: the keys of data.kinds",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectionId": {
          "description": "The dataset collection this Studio works on (todo13 D7); the task's own collection wins when they differ",
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LabelGroup"
          }
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1

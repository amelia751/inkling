{
  "id": "table-review",
  "title": "Table review",
  "description": "Any CSV, Parquet or Arrow table on a row grid: label rows or cells with a class, flag rows labelled two ways, export CSV with labels joined.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "table-review",
    "title": "Table review",
    "data": {
      "kind": "studio.table.dataKinds.table"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.table.renderers.grid"
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.table.tools.rows"
    ],
    "labels": [
      {
        "name": "rows",
        "control": "RowLabels",
        "classes": [
          {
            "id": "ok",
            "color": "#06d6a0"
          },
          {
            "id": "check",
            "color": "#ffd166"
          },
          {
            "id": "wrong",
            "color": "#ef476f"
          }
        ]
      }
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.core.panels.ai"
      ]
    },
    "exporters": [
      "studio.table.exporters.labeled-csv"
    ],
    "reviewRules": [
      "studio.table.reviewRules.row-label-disagreement",
      "studio.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "ok",
        "name": "OK",
        "synonyms": [
          "fine",
          "correct"
        ],
        "colour": "#06d6a0",
        "allowedGeometries": [
          "class"
        ]
      },
      {
        "id": "check",
        "name": "Check",
        "synonyms": [
          "unsure",
          "review"
        ],
        "colour": "#ffd166",
        "allowedGeometries": [
          "class"
        ]
      },
      {
        "id": "wrong",
        "name": "Wrong",
        "synonyms": [
          "error",
          "incorrect"
        ],
        "colour": "#ef476f",
        "allowedGeometries": [
          "class"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "license",
        "source"
      ],
      "oneModalityPerDataset": false,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": false,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {}
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

# apps/agent in the compose full stack. Non-secret dev placeholders only (see README.md).
# development, not production: AGENT_MODEL=scripted is refused in production.
APP_ENV=development
AGENT_HOST=0.0.0.0
AGENT_PORT=8100
AGENT_MODEL=scripted
AGENT_SANDBOX=off
AGENT_STORE=postgres
AGENT_DATABASE_URL=postgres://studio:dev-only-pg-password@postgres:5432/agent
AGENT_AUTO_MIGRATE=true
AGENT_EVENT_BUS=redis
AGENT_REDIS_URL=redis://redis:6379/1
SWEEPER_ENABLED=false
AGENT_API_URL=http://api:8000
AGENT_STUDIO_URL=http://router:8080
AGENT_DATA_DIR=/tmp/agent
INTERNAL_AGENT_SERVICE_TOKEN=dev-only-agent-service-token

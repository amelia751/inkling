# Non-secret settings for apps/agent. Keys live in ../../secrets/*.env (dev) or the real environment.
APP_ENV=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8100

# provider:model-id, must be in AGENT_MODEL_ALLOWLIST
AGENT_MODEL=openai:gpt-6.1-sol
AGENT_MODEL_ALLOWLIST=openai:gpt-6.1-sol,openai:gpt-6-sol,anthropic:claude-sonnet-5-5,anthropic:claude-opus-5-5
AGENT_THINKING=low

# Daytona sandbox lifecycle (minutes)
AGENT_SANDBOX_AUTO_STOP_MIN=15
AGENT_SANDBOX_AUTO_ARCHIVE_MIN=1440
AGENT_SANDBOX_AUTO_DELETE_MIN=10080
AGENT_SANDBOX_TTL_MIN=1440
# Empty = build/use the content-hashed inkling-agent-<hash> snapshot; "default" = Daytona's default image
AGENT_SANDBOX_SNAPSHOT=

# Budgets per run
AGENT_MAX_TOOL_CALLS=80
AGENT_MAX_RUN_SECONDS=900
AGENT_MAX_SPEND_USD=2
AGENT_EXEC_TIMEOUT_S=300
AGENT_TOOL_OUTPUT_MAX=65536
AGENT_CLIENT_TOOL_TIMEOUT_S=120
AGENT_APPROVAL_TIMEOUT_S=600

# Concurrency
AGENT_MAX_SESSIONS=50
AGENT_MAX_CONCURRENT_RUNS=2

# Sandboxes: `off` disables them even when DAYTONA_API_KEY is set
AGENT_SANDBOX=daytona
AGENT_SANDBOX_IDLE_STOP_MIN=30
AGENT_SANDBOX_RETENTION_DAYS=7
# `auto`: probe once (cached a day) whether this Daytona org may set egress rules (tier 3+)
AGENT_EGRESS_PROBE=auto
AGENT_UPLOAD_MAX_FILES=20
AGENT_UPLOAD_MAX_MB=200

# The Studio (Vite dev server): seed API fallback and sample uploads
AGENT_STUDIO_URL=http://localhost:5173

# The kernel (apps/api) for the builder and task profiles. The Studio mints the session's kernel
# token (POST /api/v1/sessions) and passes it with each message; nothing here holds credentials.
AGENT_KERNEL_URL=http://127.0.0.1:8000
# Optional overrides when the repo isn't next to the service (deployed image):
# AGENT_NAMING_FILE=/etc/agent/naming.json          # schemas/naming.json
# AGENT_PLUGIN_TEMPLATE_DIR=/srv/plugins/_template  # scaffold for create_plugin_sandbox

# AGENT_MODEL=scripted replays AGENT_SCRIPT (JSON) instead of calling a provider (dev/test only)
# AGENT_SCRIPT=../../tests/e2e/fixtures/agent-script.json
# AGENT_DATA_DIR=.data
LOG_LEVEL=info

# State backends (README "Scaling"). Defaults are for one dev process; replicas > 1 need postgres + redis.
AGENT_STORE=file
# AGENT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent
# AGENT_DATABASE_SCHEMA=public
# AGENT_AUTO_MIGRATE=1
AGENT_EVENT_BUS=memory
# AGENT_REDIS_URL=redis://127.0.0.1:6379
AGENT_RUN_STREAM_MAXLEN=5000
AGENT_RUN_STREAM_TTL_S=86400
AGENT_RUN_LEASE_S=30
AGENT_RUN_HEARTBEAT_S=10
AGENT_INBOX_POLL_MS=1000
# AGENT_REPLICA_ID=
AGENT_SHUTDOWN_GRACE_S=100
SWEEPER_ENABLED=true
# GIT_SHA=
# OTEL_EXPORTER_OTLP_ENDPOINT=

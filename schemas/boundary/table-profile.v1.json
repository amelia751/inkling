{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoundaryTableProfile",
  "$defs": {
    "BoundaryTableProfile": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "k": {
          "type": "number",
          "const": 10
        },
        "noise": {
          "type": "boolean"
        },
        "columns": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^<redacted:\\d{1,5}>$"
                  }
                ]
              },
              "logicalType": {
                "type": "string",
                "enum": [
                  "integer",
                  "number",
                  "boolean",
                  "date",
                  "datetime",
                  "categorical",
                  "text",
                  "identifier",
                  "empty"
                ]
              },
              "identifier": {
                "type": "boolean"
              },
              "nullRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cardinality": {
                "type": "string",
                "enum": [
                  "1",
                  "2-10",
                  "11-100",
                  "101-1000",
                  "1001-10000",
                  ">10000"
                ]
              },
              "quantiles": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "dates": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}$"
                  },
                  "frequency": {
                    "type": "string",
                    "enum": [
                      "sub-daily",
                      "daily",
                      "business-daily",
                      "weekly",
                      "monthly",
                      "quarterly",
                      "yearly",
                      "irregular"
                    ]
                  }
                },
                "required": [
                  "from",
                  "to",
                  "frequency"
                ],
                "additionalProperties": false
              },
              "categories": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
                            },
                            {
                              "type": "string",
                              "pattern": "^<redacted:\\d{1,5}>$"
                            }
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^<category:\\d{1,9}>$"
                        }
                      ]
                    },
                    "share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "value",
                    "share"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "logicalType",
              "identifier",
              "nullRate",
              "cardinality"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rows",
        "k",
        "noise",
        "columns"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/boundary/table-profile.v1"
}

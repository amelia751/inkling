{
  "$id": "studio://schema/viewer-runtime/v1",
  "protocolVersion": "2026-01-26",
  "mimeType": "text/html;profile=mcp-app",
  "tools": {
    "readAsset": "viewer_read_asset",
    "listAnnotations": "viewer_list_annotations",
    "proposeAnnotations": "viewer_propose_annotations",
    "getRuntime": "viewer_get_runtime",
    "publishRuntime": "viewer_publish_runtime"
  },
  "csp": "default-src 'none'; script-src 'unsafe-inline' blob:; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; connect-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
  "template": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline' blob:; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; connect-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{{title}}</title>\n<style id=\"studio-viewer-theme\">:root{--font-mono:Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;--font-sans:\"Inter\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;--g-ai-text:rgb(76 92 0);--g-ai-tint:rgb(224 255 79 / 0.35);--g-background:#ffffff;--g-code-inline:rgb(73 87 112);--g-code-well:rgb(244 245 247);--g-danger:rgb(207 0 43);--g-danger-heavy:rgb(221 0 56);--g-danger-tint:rgb(255 45 80 / 0.1);--g-echo-1:rgb(179 151 240);--g-echo-2:rgb(149 187 241);--g-echo-3:rgb(154 229 222);--g-echo-wash:18%;--g-float:#ffffff;--g-float-heavy:rgb(77 77 77);--g-float-hover:rgb(237 237 237);--g-generic:rgb(27 45 79 / 0.07);--g-generic-accent:rgb(27 45 79 / 0.15);--g-generic-hover:rgb(27 45 79 / 0.1);--g-header:#ffffff;--g-info:rgb(0 104 199);--g-info-tint:rgb(63 155 255 / 0.1);--g-line:rgb(27 45 79 / 0.15);--g-line-focus:rgb(93 82 246);--g-line-hover:rgb(27 45 79 / 0.2);--g-line-solid:rgb(221 224 229);--g-misc:rgb(141 156 181);--g-positive:rgb(0 132 0);--g-positive-tint:rgb(101 222 0 / 0.1);--g-selection:rgb(93 82 246 / 0.1);--g-selection-hover:rgb(93 82 246 / 0.15);--g-shadow:rgb(39 39 43 / 0.15);--g-text-brand:rgb(85 71 234);--g-text-brand-heavy:rgb(76 55 220);--g-text-complementary:rgb(27 45 79 / 0.9);--g-text-hint:rgb(27 45 79 / 0.6);--g-text-primary:rgb(17 28 48);--g-text-secondary:rgb(27 45 79 / 0.7);--g-tile-1:rgb(176 236 161);--g-tile-2:rgb(116 218 209);--g-tile-3:rgb(140 179 228);--g-tile-gradient:linear-gradient(218.56deg, var(--g-tile-1) 8.62%, var(--g-tile-2) 69.4%, var(--g-tile-3) 95.83%);--g-ultralight:rgb(246 248 250);--g-utility:rgb(85 71 234);--g-utility-tint:rgb(93 82 246 / 0.1);--g-veil:rgb(39 39 43 / 0.6);--g-warning:rgb(178 92 0);--g-warning-tint:rgb(255 161 5 / 0.15);--radius-2xl:18px;--radius-lg:8px;--radius-md:6px;--radius-sm:5px;--radius-xl:10px;--radius-xs:3px;}</style>\n<style id=\"studio-viewer-styles\">:root{color-scheme:light}\n:root[data-theme=\"dark\"]{color-scheme:dark}\nhtml,body{margin:0;padding:0;background:var(--g-background);color:var(--g-text-primary);font:13px/1.45 var(--font-sans)}\n#viewer-root{min-height:120px;padding:12px;box-sizing:border-box}\n*,*::before,*::after{box-sizing:border-box}\nh1,h2,h3{margin:0 0 8px;font-weight:600;line-height:1.3}\nh1{font-size:17px}h2{font-size:15px}h3{font-size:13px}\np{margin:0 0 8px}\nsmall,.hint{font-size:12px;color:var(--g-text-secondary)}\ncode,pre,kbd{font-family:var(--font-mono);font-size:12px}\npre{margin:0;padding:8px;background:var(--g-ultralight);border:1px solid var(--g-line);border-radius:var(--radius-md);overflow:auto}\na{color:var(--g-text-brand)}\nhr{border:0;border-top:1px solid var(--g-line);margin:12px 0}\n:focus-visible{outline:2px solid var(--g-line-focus);outline-offset:1px}\nbutton,.button{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;font:inherit;font-weight:500;color:var(--g-text-primary);background:var(--g-generic);border:1px solid transparent;border-radius:var(--radius-md);cursor:pointer}\nbutton:hover,.button:hover{background:var(--g-generic-hover)}\nbutton:disabled{opacity:.5;cursor:default}\nbutton.primary,button[data-variant=\"primary\"]{background:var(--g-utility);color:var(--g-background)}\nbutton.primary:hover,button[data-variant=\"primary\"]:hover{background:var(--g-text-brand-heavy)}\nbutton.outline,button[data-variant=\"outline\"]{background:transparent;border-color:var(--g-line)}\nbutton.danger,button[data-variant=\"danger\"]{background:var(--g-danger-tint);color:var(--g-danger)}\ninput,select,textarea{height:28px;padding:0 8px;font:inherit;color:var(--g-text-primary);background:var(--g-background);border:1px solid var(--g-line);border-radius:var(--radius-md)}\ntextarea{height:auto;padding:6px 8px}\ninput:hover,select:hover,textarea:hover{border-color:var(--g-line-hover)}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--g-line-focus)}\ninput[type=\"checkbox\"],input[type=\"radio\"],input[type=\"range\"]{height:auto;accent-color:var(--g-utility)}\nlabel{color:var(--g-text-complementary)}\ntable{width:100%;border-collapse:collapse}\nth,td{padding:6px 8px;text-align:left;border-bottom:1px solid var(--g-line)}\nth{font-weight:500;color:var(--g-text-secondary);background:var(--g-ultralight)}\ntr:hover td{background:var(--g-generic)}\ntr[aria-selected=\"true\"] td{background:var(--g-selection)}\ntd.num,th.num{text-align:right;font-variant-numeric:tabular-nums}\n[role=\"tablist\"],.tabs{display:flex;gap:4px;border-bottom:1px solid var(--g-line);margin-bottom:8px}\n[role=\"tab\"],.tab{height:32px;padding:0 10px;background:transparent;border:0;border-bottom:2px solid transparent;border-radius:0;color:var(--g-text-secondary)}\n[role=\"tab\"]:hover,.tab:hover{background:transparent;color:var(--g-text-primary)}\n[role=\"tab\"][aria-selected=\"true\"],.tab.active{color:var(--g-text-primary);border-bottom-color:var(--g-line-focus)}\n.badge{display:inline-flex;align-items:center;height:20px;padding:0 6px;font-size:12px;border-radius:var(--radius-sm);background:var(--g-generic);color:var(--g-text-complementary)}\n.badge[data-tone=\"info\"]{background:var(--g-info-tint);color:var(--g-info)}\n.badge[data-tone=\"positive\"]{background:var(--g-positive-tint);color:var(--g-positive)}\n.badge[data-tone=\"warning\"]{background:var(--g-warning-tint);color:var(--g-warning)}\n.badge[data-tone=\"danger\"]{background:var(--g-danger-tint);color:var(--g-danger)}\n.badge[data-tone=\"ai\"]{background:var(--g-ai-tint);color:var(--g-ai-text)}\n.card{padding:12px;background:var(--g-float);border:1px solid var(--g-line);border-radius:var(--radius-lg)}\n.empty-state,.error-state,[data-viewer-error]{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:120px;padding:16px;text-align:center;color:var(--g-text-secondary)}\n.error-state,[data-viewer-error]{color:var(--g-danger)}\n.toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px}</style>\n</head><body><div id=\"viewer-root\"></div>\n<script type=\"application/json\" id=\"viewer-module\">{{module}}</script>\n<script>(() => {\n  \"use strict\";\n  const PROTOCOL = \"2026-01-26\";\n  const TOOLS = {\"readAsset\":\"viewer_read_asset\",\"listAnnotations\":\"viewer_list_annotations\",\"proposeAnnotations\":\"viewer_propose_annotations\",\"getRuntime\":\"viewer_get_runtime\",\"publishRuntime\":\"viewer_publish_runtime\"};\n  let seq = 0, ctrl = null, cleanup = null, hostContext = {}, rendered = false;\n  const theme = { mode: document.documentElement.dataset.theme === \"dark\" ? \"dark\" : \"light\", vars: {} };\n  for (const k of [\"--font-mono\",\"--font-sans\",\"--g-ai-text\",\"--g-ai-tint\",\"--g-background\",\"--g-code-inline\",\"--g-code-well\",\"--g-danger\",\"--g-danger-heavy\",\"--g-danger-tint\",\"--g-echo-1\",\"--g-echo-2\",\"--g-echo-3\",\"--g-echo-wash\",\"--g-float\",\"--g-float-heavy\",\"--g-float-hover\",\"--g-generic\",\"--g-generic-accent\",\"--g-generic-hover\",\"--g-header\",\"--g-info\",\"--g-info-tint\",\"--g-line\",\"--g-line-focus\",\"--g-line-hover\",\"--g-line-solid\",\"--g-misc\",\"--g-positive\",\"--g-positive-tint\",\"--g-selection\",\"--g-selection-hover\",\"--g-shadow\",\"--g-text-brand\",\"--g-text-brand-heavy\",\"--g-text-complementary\",\"--g-text-hint\",\"--g-text-primary\",\"--g-text-secondary\",\"--g-tile-1\",\"--g-tile-2\",\"--g-tile-3\",\"--g-tile-gradient\",\"--g-ultralight\",\"--g-utility\",\"--g-utility-tint\",\"--g-veil\",\"--g-warning\",\"--g-warning-tint\",\"--radius-2xl\",\"--radius-lg\",\"--radius-md\",\"--radius-sm\",\"--radius-xl\",\"--radius-xs\"]) { const v = getComputedStyle(document.documentElement).getPropertyValue(k).trim(); if (v) theme.vars[k] = v; }\n  const pending = new Map(), listeners = new Map(), state = {};\n  const send = (msg) => parent.postMessage(Object.assign({ jsonrpc: \"2.0\" }, msg), \"*\");\n  const request = (method, params) => new Promise((resolve, reject) => { const id = ++seq; pending.set(id, { resolve, reject }); send({ id, method, params }); });\n  const notify = (method, params) => send({ method, params: params || {} });\n  const emit = (ev, v) => (listeners.get(ev) || []).slice().forEach((cb) => { try { cb(v); } catch (e) { console.error(e); } });\n  const model = {\n    get: (k) => state[k],\n    set: (k, v) => { state[k] = v; emit(\"change:\" + k, v); emit(\"change\", { [k]: v }); },\n    on: (ev, cb) => { listeners.set(ev, (listeners.get(ev) || []).concat(cb)); },\n    off: (ev, cb) => { listeners.set(ev, cb ? (listeners.get(ev) || []).filter((x) => x !== cb) : []); },\n    save_changes: () => {},\n  };\n  const b64 = (s) => { const bin = atob(s); const out = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i); return out; };\n  const text = (r) => ((r && r.content) || []).filter((c) => c.type === \"text\").map((c) => c.text).join(\" \");\n  async function call(name, args) {\n    const r = await request(\"tools/call\", { name, arguments: args || {} });\n    if (r && r.isError) throw new Error(text(r) || name + \" failed\");\n    return r || {};\n  }\n  const host = {\n    item: () => state.item,\n    get theme() { return theme; },\n    async readAsset(path) {\n      const r = await call(TOOLS.readAsset, { path });\n      const res = (r.content || []).find((c) => c.type === \"resource\" && c.resource && typeof c.resource.blob === \"string\");\n      if (!res) throw new Error(\"no bytes for \" + path);\n      return b64(res.resource.blob);\n    },\n    annotations: {\n      list: async () => ((await call(TOOLS.listAnnotations, {})).structuredContent || {}).annotations || [],\n      propose: async (list) => (await call(TOOLS.proposeAnnotations, { annotations: list })).structuredContent || { added: 0, rejected: [] },\n    },\n    runtime: {\n      get: async (key) => ((await call(TOOLS.getRuntime, { key })).structuredContent || {}).value,\n      publish: async (key, value) => { await call(TOOLS.publishRuntime, { key, value }); },\n    },\n    resize: (height) => notify(\"ui/notifications/size-changed\", { height: Math.ceil(height) }),\n    context: () => hostContext,\n  };\n  const root = document.getElementById(\"viewer-root\");\n  function fail(where, err) {\n    const p = document.createElement(\"p\");\n    p.setAttribute(\"role\", \"alert\"); p.dataset.viewerError = where;\n    p.textContent = \"Viewer error (\" + where + \"): \" + (err && err.message ? err.message : String(err));\n    root.replaceChildren(p);\n    notify(\"notifications/message\", { level: \"error\", logger: \"viewer\", data: { where, error: String(err && err.message ? err.message : err).slice(0, 500) } });\n  }\n  let modPromise = null;\n  function loadModule() {\n    if (modPromise) return modPromise;\n    const src = JSON.parse(document.getElementById(\"viewer-module\").textContent || '\"\"');\n    const url = URL.createObjectURL(new Blob([src], { type: \"text/javascript\" }));\n    modPromise = import(url).then(async (m) => {\n      const def = m.default && typeof m.default === \"object\" ? m.default : {};\n      const mod = { render: m.render || def.render || (typeof m.default === \"function\" ? m.default : undefined), initialize: m.initialize || def.initialize };\n      if (typeof mod.render !== \"function\") throw new Error(\"the module exports no render()\");\n      if (mod.initialize) await mod.initialize({ model, host });\n      return mod;\n    });\n    return modPromise;\n  }\n  async function render() {\n    if (!state.item) return;\n    if (ctrl) ctrl.abort();\n    const c = (ctrl = new AbortController());\n    if (cleanup) { try { await cleanup(); } catch (e) { console.error(e); } cleanup = null; }\n    root.replaceChildren();\n    let mod;\n    try { mod = await loadModule(); } catch (e) { return fail(\"load\", e); }\n    if (c.signal.aborted) return;\n    try {\n      const r = await mod.render({ model, el: root, signal: c.signal, host });\n      if (typeof r === \"function\") cleanup = r;\n      rendered = true;\n      document.documentElement.dataset.viewerRendered = state.item.id;\n    } catch (e) { fail(\"render\", e); }\n  }\n  function applyTheme(ctx) {\n    const vars = ctx && ctx.styles && ctx.styles.variables;\n    if (vars) for (const [k, v] of Object.entries(vars)) if (v && /^--[\\w-]+$/.test(k)) { document.documentElement.style.setProperty(k, String(v)); theme.vars[k] = String(v); }\n    if (ctx && (ctx.theme === \"dark\" || ctx.theme === \"light\")) { document.documentElement.dataset.theme = ctx.theme; theme.mode = ctx.theme; }\n    if (vars || (ctx && ctx.theme)) model.set(\"theme\", theme);\n  }\n  function merge(next) {\n    if (!next || typeof next !== \"object\") return;\n    const itemChanged = next.item && (!state.item || next.item.id !== state.item.id);\n    for (const [k, v] of Object.entries(next)) model.set(k, v);\n    if (itemChanged || !rendered) render();\n  }\n  addEventListener(\"message\", (e) => {\n    if (e.source !== parent) return;\n    const m = e.data;\n    if (!m || m.jsonrpc !== \"2.0\") return;\n    if (m.method === undefined && m.id !== undefined) {\n      const p = pending.get(m.id);\n      if (!p) return;\n      pending.delete(m.id);\n      return m.error ? p.reject(new Error(m.error.message || \"error\")) : p.resolve(m.result);\n    }\n    if (m.id !== undefined) {\n      if (m.method === \"ui/resource-teardown\") {\n        if (ctrl) ctrl.abort();\n        Promise.resolve(cleanup && cleanup()).finally(() => send({ id: m.id, result: {} }));\n      } else if (m.method === \"ping\") send({ id: m.id, result: {} });\n      else send({ id: m.id, error: { code: -32601, message: \"Method not found\" } });\n      return;\n    }\n    const params = m.params || {};\n    if (m.method === \"ui/notifications/tool-input\") model.set(\"toolInput\", params.arguments || {});\n    else if (m.method === \"ui/notifications/tool-result\") merge(params.structuredContent);\n    else if (m.method === \"ui/notifications/host-context-changed\") { Object.assign(hostContext, params); applyTheme(params); model.set(\"hostContext\", hostContext); }\n    else if (m.method === \"ui/notifications/tool-cancelled\") fail(\"cancelled\", params.reason || \"cancelled\");\n  });\n  new ResizeObserver(() => host.resize(document.documentElement.scrollHeight)).observe(document.documentElement);\n  request(\"ui/initialize\", { appInfo: { name: document.title || \"viewer\", version: \"1.0.0\" }, appCapabilities: { availableDisplayModes: [\"inline\"] }, protocolVersion: PROTOCOL })\n    .then((r) => {\n      hostContext = (r && r.hostContext) || {};\n      applyTheme(hostContext);\n      notify(\"ui/notifications/initialized\", {});\n      document.documentElement.dataset.viewerConnected = (r && r.hostInfo && r.hostInfo.name) || \"host\";\n    })\n    .catch((e) => fail(\"initialize\", e));\n})();</script>\n</body></html>"
}

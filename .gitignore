node_modules/
dist/
.env
.env.*
!.env.example
# Seed data is fetched locally per its license; only the script and manifest schema are versioned.
seed-data/*
!seed-data/README.md
.DS_Store
*.tsbuildinfo
.vite/

# Playwright screenshots and traces
apps/web/e2e/.artifacts/
__pycache__/

# Local secrets: only the README and example templates are versioned.
secrets/*
!secrets/README.md
!secrets/*.example

# Python environments, and every app's local state (api, worker, agent, versioning…)
.venv/
**/.data/
.pytest_cache/

# Parallel work: worktrees live inside the repo, never as sibling folders (todo/done/todo3.md R2)
.worktrees/
.claude/worktrees/

# Coding-agent state; only the project hooks are versioned.
.muse/*
!.muse/hooks.json
!.muse/hooks/

# Turborepo cache and build outputs
.turbo/
tests/e2e/.artifacts/

# Planning notes stay local.
todo/

# The pitch deck is local only.
presentation/

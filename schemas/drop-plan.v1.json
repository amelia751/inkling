{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DropPlan",
  "$defs": {
    "DropPlan": {
      "type": "object",
      "properties": {
        "dropId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DropAction"
          }
        },
        "needsPerson": {
          "type": "boolean"
        }
      },
      "required": [
        "dropId",
        "actions",
        "needsPerson"
      ],
      "additionalProperties": false
    },
    "DropAction": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "add_to_collection",
            "new_collection",
            "new_dataset",
            "unpack",
            "keep_reference",
            "keep_unsupported",
            "link_existing"
          ]
        },
        "datasetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "collectionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "preset": {
          "type": "string",
          "pattern": "^preset:[A-Za-z0-9._-]+$"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asks": {
          "type": "string",
          "enum": [
            "labels_table",
            "tabular_collection",
            "attach_documentation",
            "find_plugin",
            "which_dataset"
          ]
        },
        "relatesTo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "findPluginKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      },
      "required": [
        "groupId",
        "type",
        "nodeIds"
      ],
      "additionalProperties": false
    }
  },
  "$id": "inkling://schema/drop-plan/v1"
}

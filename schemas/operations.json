            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "nodeIds"
        ]
      }
    },
    {
      "id": "source.purge",
      "tool": "source_purge",
      "tier": "destroy",
      "method": "POST",
      "path": "/projects/{pid}/fs/ops",
      "description": "Delete files or folders in the Trash forever. Can't be undone.",
      "removes": "files",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "nodeIds": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "nodeIds"
        ]
      }
    },
    {

# apps/pipeline in the compose full stack. Non-secret dev placeholders only (see README.md).
# Role pipeline_app (infra/docker/postgres/init.sql): schema `pipeline` in studio, DBOS state in pipeline_engine.
STUDIO_PIPELINE_DATABASE_URL=postgres://pipeline_app:dev-only-pipeline-pw@postgres:5432/studio?sslmode=disable&search_path=pipeline
STUDIO_PIPELINE_ENGINE_DATABASE_URL=postgres://pipeline_app:dev-only-pipeline-pw@postgres:5432/pipeline_engine?sslmode=disable
STUDIO_PIPELINE_DB_POOL_MAX=8
# The kernel's service routes (todo12 §5), as the service:pipeline principal.
STUDIO_PIPELINE_API_URL=http://api:8000
STUDIO_PIPELINE_API_TOKEN=dev-only-pipeline-token
STUDIO_PIPELINE_VERSIONING_URL=http://versioning:8090
# A fixed executor ID so a restarted container recovers its own pending workflows.
STUDIO_PIPELINE_EXECUTOR_ID=pipeline-0
# PIPELINE_APP_VERSION defaults to the workflow package digest baked into the image.

{
  "id": "satellite-tiles",
  "title": "Satellite tiles",
  "description": "Deep-zoom satellite or aerial imagery (DZI): building footprints, fields and points of interest, with areas in m\u00b2 from metres per pixel.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "satellite-tiles",
    "title": "Satellite tiles",
    "data": {
      "kind": "studio.wsi.dataKinds.raster-pyramid"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.wsi.renderers.osd",
        "config": {
          "mpp": 500000
        }
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.core.tools.pan",
      "studio.overlay2d.tools.box",
      "studio.overlay2d.tools.polygon",
      "studio.wsi.tools.brush",
      "studio.wsi.tools.eraser",
      "studio.wsi.tools.mark",
      "studio.wsi.tools.length"
    ],
    "labels": [
      {
        "name": "land",
        "control": "PolygonLabels",
        "classes": [
          {
            "id": "building",
            "color": "#e4572e"
          },
          {
            "id": "field",
            "color": "#76b041"
          },
          {
            "id": "water",
            "color": "#17bebb"
          }
        ]
      },
      {
        "name": "poi",
        "control": "KeyPointLabels",
        "classes": [
          {
            "id": "tree",
            "color": "#2e7d32"
          }
        ]
      }
    ],
    "exporters": [
      "studio.wsi.exporters.qupath-geojson",
      "studio.wsi.exporters.point-counts-csv"
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.core.panels.ai"
      ]
    },
    "reviewRules": [
      "studio.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "building",
        "name": "building",
        "synonyms": [
          "footprint"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "polygon",
          "box"
        ]
      },
      {
        "id": "field",
        "name": "field",
        "synonyms": [
          "farmland",
          "crop"
        ],
        "colour": "#22c55e",
        "allowedGeometries": [
          "polygon"
        ]
      },
      {
        "id": "water",
        "name": "water",
        "synonyms": [
          "lake",
          "river"
        ],
        "colour": "#3b82f6",
        "allowedGeometries": [
          "polygon"
        ]
      },
      {
        "id": "tree",
        "name": "tree",
        "synonyms": [],
        "colour": "#15803d",
        "allowedGeometries": [
          "point"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "license",
        "source"
      ],
      "oneModalityPerDataset": false,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {}
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

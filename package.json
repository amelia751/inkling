{
  "name": "studio-workspace",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:signin": "node tools/dev.mjs --signin",
    "dev:reset": "node tools/dev-reset.mjs",
    "test:tools": "node --test tools/dev-reset.test.mjs tools/check-deploy-auth.test.mjs",
    "doctor": "node tools/doctor.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm check:deploy-auth",
    "affected": "turbo run test typecheck lint --filter=...[origin/main]",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:names": "node tools/check-names.mjs",
    "check:deploy-auth": "node tools/check-deploy-auth.mjs && node --test tools/check-deploy-auth.test.mjs",
    "check:python-imports": "uv run lint-imports",
    "check:writes": "uv run pytest tools/check-writes -q -s -p no:cacheprovider",
    "viewer-lint": "node packages/plugin-ui-sdk/scripts/viewer-lint.mjs",
    "emit:schemas": "pnpm --filter @studio/web emit:schemas",
    "build:registry": "node tools/build-registry.mjs",
    "seeds": "uv run tools/fetch-seeds.py",
    "seeds:upload": "uv run tools/fetch-seeds.py --upload",
    "mcp": "pnpm --filter @studio/mcp dev",
    "mcp:http": "pnpm --filter @studio/mcp dev:http",
    "harness": "node tools/harness/harness.mjs",
    "site": "pnpm --filter @studio/site dev",
    "agent": "pnpm --filter @studio/agent dev",
    "agent:test": "pnpm --filter @studio/agent test",
    "agent:live": "pnpm --filter @studio/agent test:live",
    "api": "pnpm --filter @studio/api dev",
    "test:api": "pnpm --filter @studio/api test",
    "infra:up": "docker compose -f infra/docker/compose.yaml --profile deps up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml --profile deps down",
    "stack:up": "docker compose -f infra/docker/compose.yaml --profile full up -d --build --wait",
    "stack:down": "docker compose -f infra/docker/compose.yaml --profile full down",
    "k8s:build": "kubectl kustomize infra/k8s/overlays/dev",
    "k8s:dev-keys": "node tools/versioning-keys.mjs --namespace studio-dev"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "^5"
  }
}

{
  "name": "@studio/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for apps/api, generated from schemas/api/openapi.json (no app imports)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../schemas/api/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "^5"
  }
}

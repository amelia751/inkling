{
  "id": "image-2d",
  "title": "2D image",
  "description": "Radiographs and photos on a Cornerstone3D stack: window/level, ROI shapes, measurements, masks; COCO and DICOM export.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "image-2d",
    "title": "2D image",
    "data": {
      "kind": "inkling.image2d.dataKinds.raster"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.image2d.renderers.cornerstone-stack"
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.cornerstone.tools.zoom",
      "inkling.core.tools.windowLevel",
      "inkling.cornerstone.tools.box",
      "inkling.cornerstone.tools.ellipse",
      "inkling.cornerstone.tools.polygon",
      "inkling.cornerstone.tools.freehand",
      "inkling.cornerstone.tools.keypoint",
      "inkling.cornerstone.tools.length",
      "inkling.cornerstone.tools.angle",
      "inkling.cornerstone.tools.cobb",
      "inkling.cornerstone.tools.bidirectional",
      "inkling.cornerstone.tools.probe",
      "inkling.cornerstone.tools.arrow",
      "inkling.cornerstone.tools.brush",
      "inkling.cornerstone.tools.eraser",
      "inkling.cornerstone.tools.wand"
    ],
    "exporters": [
      "inkling.image2d.exporters.coco",
      "inkling.dicom-export.exporters.dicom-seg",
      "inkling.dicom-export.exporters.dicom-sr"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels"
      ],
      "right": [
        "inkling.core.panels.ai"
      ],
      "viewport-bar": [
        "inkling.image2d.panels.viewControls"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.source-label-disagreement",
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "normal",
        "name": "Normal",
        "synonyms": [
          "no finding",
          "unremarkable"
        ],
        "colour": "#22c55e",
        "allowedGeometries": [
          "box",
          "polygon",
          "ellipse",
          "freehand",
          "mask",
          "point"
        ]
      },
      {
        "id": "pneumonia",
        "name": "Pneumonia",
        "synonyms": [
          "PNA",
          "consolidation"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "box",
          "polygon",
          "ellipse",
          "freehand",
          "mask",
          "point"
        ]
      },
      {
        "id": "nodule",
        "name": "Nodule",
        "synonyms": [
          "mass",
          "lesion"
        ],
        "colour": "#f59e0b",
        "allowedGeometries": [
          "box",
          "polygon",
          "ellipse",
          "freehand",
          "mask",
          "point"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "modality",
        "license",
        "source"
      ],
      "oneModalityPerDataset": true,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {
        "dicom.series-incomplete": "warn"
      }
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "review.v1",
      "type": "string",
      "const": "review.v1"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact kind: plugin, preview, recipe…"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "description": "Reviewer principal; never the artifact's author"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "provider:model-id of the reviewing model (or a rules engine id)"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "block",
        "needs-person"
      ]
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "info"
            ]
          },
          "class": {
            "type": "string",
            "minLength": 1,
            "description": "Problem class, e.g. hidden-network, off-token-colour, fixture-overfit, licence, storage-read, runtime-escape, main-thread-stall, cross-renderer"
          },
          "file": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "What is wrong, in one or two sentences"
          },
          "test": {
            "default": null,
            "description": "Hidden adversarial test that demonstrates it (a hidden-tests path), or null",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "severity",
          "class",
          "claim"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": [
    "artifact",
    "reviewer",
    "model",
    "verdict",
    "createdAt"
  ],
  "$id": "studio://schema/review/v1"
}

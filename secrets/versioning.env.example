# Copy to versioning.env (git-ignored). apps/versioning reads its config from the
# environment; with the naming config (schemas/naming.json) envPrefix "INKLING_",
# every key below is prefixed, e.g. INKLING_VERSIONING_DATABASE_URL (todo4 V11).
# Without a naming config the keys are exactly as written here.

VERSIONING_HTTP_ADDR=:8090
# The versioning_app role: DML only, subject to row-level security.
VERSIONING_DATABASE_URL=postgres://versioning_app:CHANGE_ME@localhost:5432/studio?sslmode=disable
VERSIONING_DEFAULT_BRANCH=main

# Object storage. OBJECT_STORE: s3 (any S3-compatible API; local dev: a server on :9000) or gcs
# (Cloud Storage with Application Default Credentials; the endpoint, region and S3 keys are unused).
VERSIONING_OBJECT_STORE=s3
VERSIONING_OBJECT_ENDPOINT=http://localhost:9000
VERSIONING_OBJECT_REGION=us-east-1
# Defaults to ${resourcePrefix}-objects / ${resourcePrefix}-manifests.
VERSIONING_OBJECT_BUCKET=
VERSIONING_MANIFEST_BUCKET=
# Credentials scoped to the two buckets only.
VERSIONING_S3_ACCESS_KEY_ID=
VERSIONING_S3_SECRET_ACCESS_KEY=

# Ed25519 public key(s) of apps/api, as a JWKS file (todo4 V4). The private key
# lives only in apps/api's secrets.
VERSIONING_JWT_PUBLIC_KEY_FILE=./secrets/versioning-jwks.json
VERSIONING_JWT_AUDIENCE=versioning
VERSIONING_JWT_ISSUER=api

# Events: "log" locally, "redis" (Redis Streams) in the stack.
VERSIONING_EVENT_BUS=log
VERSIONING_REDIS_URL=

VERSIONING_MAX_COMMIT_ENTRIES=1000000
VERSIONING_GC_GRACE_HOURS=168
VERSIONING_GC_SWEEP_ENABLED=false
VERSIONING_PURGE_ENABLED=false

# cmd/migrate only: the owner role runs migrations; bootstrap needs a superuser.
VERSIONING_MIGRATE_DATABASE_URL=postgres://versioning_owner:CHANGE_ME@localhost:5432/studio?sslmode=disable
VERSIONING_ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/studio?sslmode=disable
VERSIONING_OWNER_PASSWORD=
VERSIONING_APP_PASSWORD=

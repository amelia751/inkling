{
  "id": "drone-video-tracks",
  "title": "Drone video tracks",
  "description": "Aerial video: vehicles and people tracked across frames with keyframed boxes; MOT and CVAT export.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "drone-video-tracks",
    "title": "Drone video tracks",
    "data": {
      "kind": "inkling.video.dataKinds.video"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.video.renderers.frame-canvas"
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.overlay2d.tools.box",
      "inkling.timeline.tools.event"
    ],
    "labels": [
      {
        "name": "objects",
        "control": "VideoRectangle",
        "classes": [
          {
            "id": "car",
            "color": "#ef476f"
          },
          {
            "id": "truck",
            "color": "#ffd166"
          },
          {
            "id": "person",
            "color": "#06d6a0"
          }
        ],
        "attributes": {
          "occluded": {
            "type": "boolean"
          }
        }
      }
    ],
    "exporters": [
      "inkling.video.exporters.mot",
      "inkling.video.exporters.cvat-video"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels"
      ],
      "right": [
        "inkling.core.panels.ai"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "car",
        "name": "car",
        "synonyms": [
          "automobile"
        ],
        "colour": "#3b82f6",
        "allowedGeometries": [
          "box"
        ]
      },
      {
        "id": "truck",
        "name": "truck",
        "synonyms": [
          "lorry"
        ],
        "colour": "#f59e0b",
        "allowedGeometries": [
          "box"
        ]
      },
      {
        "id": "person",
        "name": "person",
        "synonyms": [
          "pedestrian"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "box"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "license",
        "source"
      ],
      "oneModalityPerDataset": false,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {}
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

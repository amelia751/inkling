{
  "name": "@studio/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The public marketing site: one static page, served by nginx",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:boundaries": "node ../../tools/check-boundaries.mjs",
    "check:names": "node ../../tools/check-names.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@studio/contracts": "workspace:*",
    "@studio/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineStepOutput",
  "$defs": {
    "PipelineStepOutput": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "partition_id": {
          "type": "string",
          "pattern": "^[0-9]{1,6}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PipelinePortValue"
          }
        },
        "items": {
          "default": [],
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PipelineItemReport"
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "items_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "items_out": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "items_quarantined": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "items_in",
            "items_out",
            "items_quarantined"
          ],
          "additionalProperties": false
        },
        "error": {
          "$ref": "#/$defs/PipelineErrorEnvelope"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "partition_id",
        "attempt",
        "outputs"
      ],
      "additionalProperties": false
    },
    "PipelinePortValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "upload_session",
            "item_set",
            "artifact_set",
            "report",
            "dataset_commit",
            "candidate_commit"
          ]
        },
        "manifest": {
          "$ref": "#/$defs/PipelineArtifactRef"
        },
        "commit": {
          "type": "object",
          "properties": {
            "repo_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "branch": {
              "type": "string",
              "maxLength": 255
            }
          },
          "required": [
            "repo_id",
            "commit"
          ],
          "additionalProperties": false
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PipelineArtifactRef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/=-]{0,511}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+\\/[a-z0-9.+-]+$"
        }
      },
      "required": [
        "key",
        "digest",
        "size",
        "media_type"
      ],
      "additionalProperties": false
    },
    "PipelineItemReport": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "discovered",
            "staged",
            "validated",
            "quarantined",
            "processed",
            "proposed",
            "rejected"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "retryable": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/PipelineErrorEnvelope"
        }
      },
      "required": [
        "item_id",
        "state"
      ],
      "additionalProperties": false
    },
    "PipelineErrorEnvelope": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "transient",
            "rate_limited",
            "worker_crash",
            "invalid_input",
            "schema_incompatible",
            "user_code_error",
            "policy_denied",
            "resource_exceeded",
            "permanent_dependency",
            "approval_timeout",
            "cancelled",
            "deadline_exceeded"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 300
        },
        "retryable": {
          "type": "boolean"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "partition_id": {
          "type": "string",
          "pattern": "^[0-9]{1,6}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "class",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/pipeline/step-output.v1"
}

{
  "id": "cine-4d",
  "title": "4D cine",
  "description": "Cardiac cine MRI: spline contours and masks per slice and frame, copy-forward, ED/ES phases, function metrics; ACDC NIfTI export.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "cine-4d",
    "title": "4D cine",
    "data": {
      "kind": "inkling.cine.dataKinds.volume-time"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.cine.renderers.slice-frame-canvas",
        "config": {
          "structures": {
            "rv": "right ventricle",
            "myo": "myocardium",
            "lv": "left ventricle"
          },
          "keyFrames": [
            {
              "id": "ED",
              "label": "End-diastole"
            },
            {
              "id": "ES",
              "label": "End-systole"
            }
          ]
        }
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.core.tools.windowLevel",
      "inkling.overlay2d.tools.spline",
      "inkling.overlay2d.tools.polygon",
      "inkling.overlay2d.tools.freehand",
      "inkling.overlay2d.tools.brush",
      "inkling.overlay2d.tools.eraser"
    ],
    "exporters": [
      "inkling.cine.exporters.acdc-nifti",
      "inkling.cardiac-metrics.exporters.function-csv",
      "inkling.cine.exporters.cine-contours-json"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels",
        "inkling.core.panels.review"
      ],
      "right": [
        "inkling.cardiac-metrics.panels.metrics",
        "inkling.core.panels.ai"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.source-label-disagreement",
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoundaryFixtureSet",
  "$defs": {
    "BoundaryFixtureSet": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "boundary.fixtures/v1"
        },
        "fixtureSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "sampleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "fingerprintDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generator": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixtures": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^fixture-\\d{2}[a-z0-9-]{0,24}\\.[a-z0-9.]{1,12}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "mediaType": {
                "type": "string",
                "pattern": "^[a-z]+\\/[a-z0-9.+-]{1,64}$"
              },
              "variant": {
                "type": "string",
                "enum": [
                  "noise",
                  "phantom",
                  "zeros",
                  "edge-min",
                  "edge-max",
                  "planted"
                ]
              }
            },
            "required": [
              "name",
              "bytes",
              "sha256",
              "mediaType",
              "variant"
            ],
            "additionalProperties": false
          }
        },
        "truth": {
          "type": "object",
          "properties": {
            "truthId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "plants": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "truthId",
            "sha256",
            "plants"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "fixtureSetId",
        "sampleId",
        "fingerprintDigest",
        "generator",
        "seed",
        "fixtures"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/boundary/fixtures.v1"
}

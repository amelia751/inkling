# Non-secret settings for apps/agent. Keys live in ../../secrets/*.env (dev) or the real environment.
STUDIO_ENV=development
STUDIO_AGENT_HOST=127.0.0.1
STUDIO_AGENT_PORT=8100

# provider:model-id, must be in STUDIO_AGENT_MODEL_ALLOWLIST
STUDIO_AGENT_MODEL=openai:gpt-6.1-sol
STUDIO_AGENT_MODEL_ALLOWLIST=openai:gpt-6.1-sol,openai:gpt-6-sol,anthropic:claude-sonnet-5-5,anthropic:claude-opus-5-5
STUDIO_AGENT_THINKING=low

# Daytona sandbox lifecycle (minutes)
STUDIO_AGENT_SANDBOX_AUTO_STOP_MIN=15
STUDIO_AGENT_SANDBOX_AUTO_ARCHIVE_MIN=1440
STUDIO_AGENT_SANDBOX_AUTO_DELETE_MIN=10080
STUDIO_AGENT_SANDBOX_TTL_MIN=1440
# Empty = build/use the content-hashed studio-agent-<hash> snapshot; "default" = Daytona's default image
STUDIO_AGENT_SANDBOX_SNAPSHOT=

# Budgets per run
STUDIO_AGENT_MAX_TOOL_CALLS=80
STUDIO_AGENT_MAX_RUN_SECONDS=900
STUDIO_AGENT_MAX_SPEND_USD=2
STUDIO_AGENT_EXEC_TIMEOUT_S=300
STUDIO_AGENT_TOOL_OUTPUT_MAX=65536
STUDIO_AGENT_CLIENT_TOOL_TIMEOUT_S=120
STUDIO_AGENT_APPROVAL_TIMEOUT_S=600

# Concurrency
STUDIO_AGENT_MAX_SESSIONS=50
STUDIO_AGENT_MAX_CONCURRENT_RUNS=2

# Sandboxes: `off` disables them even when DAYTONA_API_KEY is set
STUDIO_AGENT_SANDBOX=daytona
# daytona | local | gke | fake | off (todo10 §6.2). Sandboxes never get a network: on a Daytona
# org that can't block it (tier 1-2) creation fails unless AGENT_SANDBOX_NETWORK=org-default (dev).
STUDIO_AGENT_SANDBOX_NETWORK=block
STUDIO_AGENT_SANDBOX_BUILD_TTL_MIN=60
STUDIO_AGENT_SANDBOX_LOCAL_IMAGE=
STUDIO_AGENT_SANDBOX_LOCAL_RUNTIME=runsc
STUDIO_AGENT_SANDBOX_GKE_NAMESPACE=sandboxes
STUDIO_AGENT_SANDBOX_GKE_TEMPLATE=plugin-build
STUDIO_AGENT_SANDBOX_IDLE_STOP_MIN=30
STUDIO_AGENT_SANDBOX_RETENTION_DAYS=7
# `auto`: probe once (cached a day) whether this Daytona org may set egress rules (tier 3+)
STUDIO_AGENT_EGRESS_PROBE=auto

# The Studio (Vite dev server): seed API fallback and sample uploads
STUDIO_WEB_URL=http://localhost:5173

# The kernel (apps/api) for the builder and task profiles. The Studio mints the session's kernel
# token (POST /api/v1/sessions) and passes it with each message; nothing here holds credentials.
STUDIO_API_URL=http://127.0.0.1:8000
# Optional overrides when the repo isn't next to the service (deployed image):
# NAMING_FILE=/etc/agent/naming.json          # schemas/naming.json
# STUDIO_AGENT_PLUGIN_TEMPLATE_DIR=/srv/plugins/_template  # scaffold for create_plugin_sandbox

# STUDIO_AGENT_MODEL=scripted replays STUDIO_AGENT_SCRIPT (JSON) instead of calling a provider (dev/test only)
# STUDIO_AGENT_SCRIPT=../../tests/e2e/fixtures/agent-script.json
# STUDIO_AGENT_DATA_DIR=.data
STUDIO_LOG_LEVEL=info

# State backends (README "Scaling"). Defaults are for one dev process; replicas > 1 need postgres + redis.
STUDIO_AGENT_STORE=file
# STUDIO_AGENT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent
# STUDIO_AGENT_DATABASE_SCHEMA=public
# STUDIO_AGENT_AUTO_MIGRATE=1
STUDIO_AGENT_EVENT_BUS=memory
# STUDIO_AGENT_REDIS_URL=redis://127.0.0.1:6379
STUDIO_AGENT_RUN_STREAM_MAXLEN=5000
STUDIO_AGENT_RUN_STREAM_TTL_S=86400
STUDIO_AGENT_RUN_LEASE_S=30
STUDIO_AGENT_RUN_HEARTBEAT_S=10
STUDIO_AGENT_INBOX_POLL_MS=1000
# STUDIO_AGENT_REPLICA_ID=
STUDIO_AGENT_SHUTDOWN_GRACE_S=100
STUDIO_AGENT_SWEEPER_ENABLED=true
# GIT_SHA=
# OTEL_EXPORTER_OTLP_ENDPOINT=

{
  "id": "generic-image",
  "title": "Generic image",
  "description": "Natural images (photos, scans, screenshots) on a light canvas renderer: boxes, polygons and keypoints with select / move / resize; COCO export. No Cornerstone, no window/level.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "generic-image",
    "title": "Generic image",
    "data": {
      "kind": "inkling.image2d.dataKinds.raster"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.image2d.renderers.canvas-raster"
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.overlay2d.tools.box",
      "inkling.overlay2d.tools.polygon",
      "inkling.overlay2d.tools.keypoint"
    ],
    "exporters": [
      "inkling.image2d.exporters.coco"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels"
      ],
      "right": [
        "inkling.core.panels.ai"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.source-label-disagreement",
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "overrides": [
      {
        "id": "inkling.cornerstone.tools.cobb",
        "disabled": true
      }
    ],
    "layout": null
  }
}

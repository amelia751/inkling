{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoundaryProbeRequest",
  "$defs": {
    "BoundaryProbeRequest": {
      "type": "object",
      "properties": {
        "probes": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "magic"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2}){1,16}$"
                  }
                },
                "required": [
                  "op",
                  "offset",
                  "hex"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "read_int"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 4
                      },
                      {
                        "type": "number",
                        "const": 8
                      }
                    ]
                  },
                  "signed": {
                    "type": "boolean"
                  },
                  "endian": {
                    "type": "string",
                    "enum": [
                      "little",
                      "big"
                    ]
                  }
                },
                "required": [
                  "op",
                  "offset",
                  "width",
                  "signed",
                  "endian"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "read_float"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 4
                      },
                      {
                        "type": "number",
                        "const": 8
                      }
                    ]
                  },
                  "endian": {
                    "type": "string",
                    "enum": [
                      "little",
                      "big"
                    ]
                  }
                },
                "required": [
                  "op",
                  "offset",
                  "width",
                  "endian"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "find"
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2}){1,8}$"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
                },
                "required": [
                  "op",
                  "hex"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "read_text"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  }
                },
                "required": [
                  "op",
                  "offset",
                  "length"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "field_names"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "section_sizes"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "size"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "probes"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/boundary/probe-request.v1"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ConversionSummary",
  "$defs": {
    "ConversionSummary": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "converter": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            },
            "runtime": {
              "type": "string",
              "enum": [
                "python",
                "wasm"
              ]
            }
          },
          "required": [
            "id",
            "version",
            "runtime"
          ],
          "additionalProperties": false
        },
        "shape": {
          "type": "string",
          "enum": [
            "zarr",
            "arrow",
            "assets"
          ]
        },
        "error": {
          "type": "string",
          "enum": [
            "unsupported-input",
            "invalid-output",
            "output-too-large",
            "timeout",
            "memory",
            "crash",
            "denied",
            "converter-invalid"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$"
              },
              "mediaType": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "dims": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "dtype": {
                "type": "string",
                "enum": [
                  "bool",
                  "int8",
                  "uint8",
                  "int16",
                  "uint16",
                  "int32",
                  "uint32",
                  "int64",
                  "uint64",
                  "float16",
                  "float32",
                  "float64"
                ]
              },
              "range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "path",
              "mediaType",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "dataKind": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ok",
        "converter",
        "durationMs"
      ],
      "additionalProperties": false
    }
  },
  "$id": "inkling://schema/conversion-summary/v1"
}

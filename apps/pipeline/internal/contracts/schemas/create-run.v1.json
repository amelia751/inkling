{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineCreateRunRequest",
  "$defs": {
    "PipelineCreateRunRequest": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "definition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PipelineRunInputBinding"
          }
        },
        "target": {
          "type": "object",
          "properties": {
            "repo_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "repo_id",
            "branch"
          ],
          "additionalProperties": false
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 64
            },
            "source_event_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#@-]{0,254}$"
        },
        "actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "correlation_id": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "workspace_id",
        "project_id",
        "definition_id",
        "inputs",
        "target",
        "trigger",
        "idempotency_key",
        "actor"
      ],
      "additionalProperties": false
    },
    "PipelineRunInputBinding": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repo_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "inkling://schema/pipeline/create-run.v1"
}

# apps/api in the compose full stack. Non-secret dev placeholders only (see README.md).
# development, not production: production refuses dev sign-in and trusted headers (todo22 D2).
STUDIO_ENV=development
STUDIO_API_DATABASE_URL=postgresql+psycopg://studio:dev-only-pg-password@postgres:5432/studio
STUDIO_API_CREATE_TABLES=0
STUDIO_API_SECRET_KEY=dev-only-api-secret-key-not-for-production-0000
STUDIO_API_WORKER_TOKEN=dev-only-worker-token
STUDIO_API_DEV_TRUST_HEADERS=1
# Sign-in (todo9): `dev` trusts the dev identity headers. To sign in against WorkOS Emulate
# (service workos-emulate), put these in secrets/api.env with a Fernet cookie password (never
# here) and DEV_TRUST_HEADERS=0; README.md, "Signing in".
STUDIO_API_AUTH_MODE=dev
#   STUDIO_API_WORKOS_BASE_URL=http://workos-emulate:4100/
#   STUDIO_API_WORKOS_API_KEY=sk_test_default
#   STUDIO_API_WORKOS_CLIENT_ID=client_emulated
#   STUDIO_API_WORKOS_ISSUER=http://localhost:4100/user_management/client_emulated
#   STUDIO_API_WORKOS_REDIRECT_URI=http://localhost:8080/api/auth/callback
#   STUDIO_API_PUBLIC_URL=http://localhost:8080
STUDIO_REDIS_URL=redis://redis:6379/0
STUDIO_JOB_QUEUE=redis
STUDIO_EVENT_BUS=redis
STUDIO_BLOB_STORE=s3
STUDIO_S3_ENDPOINT=http://s3:9000
STUDIO_S3_BUCKET=assets
STUDIO_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev-only-s3-access
AWS_SECRET_ACCESS_KEY=dev-only-s3-secret
STUDIO_API_VERSIONING_URL=http://versioning:8090
STUDIO_API_VERSIONING_JWT_KEY_FILE=/keys/jwt.key
STUDIO_API_VERSIONING_JWKS_FILE=/keys/jwks.json
STUDIO_API_VERSIONING_JWT_KID=dev
STUDIO_API_APPROVAL_SECRET=dev-only-approval-secret

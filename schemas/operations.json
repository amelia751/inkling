{
  "$id": "inkling://schema/operations/v1",
  "operations": [
    {
      "id": "source.list",
      "tool": "source_list",
      "tier": "read",
      "method": "GET",
      "path": "/projects/{pid}/fs/children",
      "description": "List a folder's children in Sources by current names (no contents).",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "minLength": 1
          },
          "trashed": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "source.search",
      "tool": "source_search",
      "tier": "read",
      "method": "GET",
      "path": "/projects/{pid}/search",
      "description": "Find files and folders in Sources by name.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "id": "source.mkdir",
      "tool": "source_mkdir",

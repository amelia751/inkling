{
  "name": "@studio/pipeline",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/server",
    "build": "go build -o dist/ ./cmd/...",
    "test": "go test -race ./...",
    "test:chaos": "go test -count=1 -timeout=60m -v ./tests/chaos/...",
    "lint": "golangci-lint run",
    "typecheck": "go vet ./...",
    "generate": "go generate ./..."
  }
}

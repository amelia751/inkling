# WorkOS (todo9). Copy to secrets/workos.env (git-ignored) and fill in; never commit or print it.
# api reads this file in dev (secrets/api.env wins over it); the agent reads every secrets/*.env.
# Nothing here turns sign-in on: the api stays in `dev` mode until INKLING_API_AUTH_MODE=workos.
# How to sign in locally (dev mode, WorkOS Emulate, staging): docs/running.md, "Signing in".
#
# Staging keys start with sk_test_, production keys with sk_live_ (never use production locally).
# For WorkOS Emulate use sk_test_default and client_emulated with the base URL below.

# --- Secrets ------------------------------------------------------------------------------
# Server API key (WorkOS dashboard → API Keys). The worker reads the same name for event sync.
INKLING_API_WORKOS_API_KEY=
# Seals the session cookie. Must be a Fernet key, the same on every replica:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INKLING_API_WORKOS_COOKIE_PASSWORD=
# Organization API key for the MCP server over stdio (Settings → API keys). apps/mcp reads only
# its process env: put it in your MCP client's `env` for the server; this is where to keep it.
INKLING_MCP_API_KEY=

# --- Not secret ---------------------------------------------------------------------------
# AuthKit client id (dashboard → API Keys), `client_…`; also names the JWKS URL.
INKLING_API_WORKOS_CLIENT_ID=
# Uncomment as needed (an empty value is not the same as unset for every service):
# INKLING_API_AUTH_MODE=workos
# INKLING_API_DEV_TRUST_HEADERS=0
# Exactly as on the dashboard's Redirects tab (no trailing slash).
# INKLING_API_WORKOS_REDIRECT_URI=http://localhost:5173/api/auth/callback
# INKLING_API_PUBLIC_URL=http://localhost:5173
# Expected `iss`; unchecked when unset. WorkOS: https://api.workos.com/user_management/<client id>;
# Emulate: http://localhost:4100/user_management/<client id>.
# INKLING_API_WORKOS_ISSUER=
# WorkOS Emulate (pnpm infra:up starts it on :4100); unset = https://api.workos.com/.
# INKLING_API_WORKOS_BASE_URL=http://localhost:4100/
# Agent (todo9 Phase 5): verifies the person's access token on proxied calls.
# INKLING_AGENT_AUTH_MODE=workos
# INKLING_AGENT_WORKOS_CLIENT_ID=
# INKLING_AGENT_WORKOS_ISSUER=
# INKLING_AGENT_WORKOS_BASE_URL=http://localhost:4100

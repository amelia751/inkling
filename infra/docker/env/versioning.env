# apps/versioning in the compose full stack. Non-secret dev placeholders only (see README.md).
# Server (versioning_app: DML only, row-level security applies).
INKLING_VERSIONING_DATABASE_URL=postgres://versioning_app:dev-only-app-pw@postgres:5432/studio?sslmode=disable
INKLING_VERSIONING_OBJECT_ENDPOINT=http://s3:9000
INKLING_VERSIONING_OBJECT_REGION=us-east-1
INKLING_VERSIONING_OBJECT_PATH_STYLE=true
INKLING_VERSIONING_S3_ACCESS_KEY_ID=dev-only-s3-access
INKLING_VERSIONING_S3_SECRET_ACCESS_KEY=dev-only-s3-secret
INKLING_VERSIONING_JWT_PUBLIC_KEY_FILE=/keys/jwks.json
INKLING_VERSIONING_EVENT_BUS=redis
INKLING_VERSIONING_REDIS_URL=redis://redis:6379/2
# cmd/migrate: bootstrap (superuser) creates the roles and schema, then the owner migrates.
INKLING_VERSIONING_ADMIN_DATABASE_URL=postgres://studio:dev-only-pg-password@postgres:5432/studio?sslmode=disable
INKLING_VERSIONING_OWNER_PASSWORD=dev-only-owner-pw
INKLING_VERSIONING_APP_PASSWORD=dev-only-app-pw
INKLING_VERSIONING_MIGRATE_DATABASE_URL=postgres://versioning_owner:dev-only-owner-pw@postgres:5432/studio?sslmode=disable

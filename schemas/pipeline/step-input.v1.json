{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineStepInput",
  "$defs": {
    "PipelineStepInput": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "partition_id": {
          "type": "string",
          "pattern": "^[0-9]{1,6}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#@-]{0,254}$"
        },
        "uses": {
          "type": "string",
          "maxLength": 160
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PipelinePortValue"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 63
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "params_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_prefix": {
          "type": "string",
          "pattern": "^pipeline\\/[A-Za-z0-9_.:-]+\\/[a-z][a-z0-9_-]*\\/$"
        },
        "range": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "offset",
            "limit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "workspace_id",
        "project_id",
        "step_id",
        "partition_id",
        "idempotency_key",
        "uses",
        "inputs",
        "params",
        "params_digest",
        "output_prefix"
      ],
      "additionalProperties": false
    },
    "PipelinePortValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "upload_session",
            "item_set",
            "artifact_set",
            "report",
            "dataset_commit",
            "candidate_commit"
          ]
        },
        "manifest": {
          "$ref": "#/$defs/PipelineArtifactRef"
        },
        "commit": {
          "type": "object",
          "properties": {
            "repo_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "branch": {
              "type": "string",
              "maxLength": 255
            }
          },
          "required": [
            "repo_id",
            "commit"
          ],
          "additionalProperties": false
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PipelineArtifactRef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/=-]{0,511}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+\\/[a-z0-9.+-]+$"
        }
      },
      "required": [
        "key",
        "digest",
        "size",
        "media_type"
      ],
      "additionalProperties": false
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "studio://schema/pipeline/step-input.v1"
}

{
  "id": "pathology",
  "title": "Whole-slide",
  "description": "Whole-slide images: vector regions, region brush and wand, cell counting, \u00b5m measurements; QuPath GeoJSON, ASAP XML and counts export.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "pathology",
    "title": "Whole-slide",
    "data": {
      "kind": "studio.wsi.dataKinds.raster-pyramid"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.wsi.renderers.osd"
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.core.tools.pan",
      "studio.overlay2d.tools.box",
      "studio.overlay2d.tools.ellipse",
      "studio.overlay2d.tools.polygon",
      "studio.overlay2d.tools.freehand",
      "studio.overlay2d.tools.polyline",
      "studio.wsi.tools.brush",
      "studio.wsi.tools.eraser",
      "studio.wsi.tools.wand",
      "studio.wsi.tools.mark",
      "studio.wsi.tools.length"
    ],
    "exporters": [
      "studio.wsi.exporters.qupath-geojson",
      "studio.wsi.exporters.asap-xml",
      "studio.wsi.exporters.point-counts-csv"
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.core.panels.ai",
        "studio.wsi.panels.counts"
      ],
      "viewport-bar": [
        "studio.wsi.panels.adjust"
      ]
    },
    "reviewRules": [
      "studio.core.reviewRules.source-label-disagreement",
      "studio.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "tumor",
        "name": "Tumour",
        "synonyms": [
          "tumor",
          "carcinoma"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "polygon",
          "mask",
          "freehand"
        ]
      },
      {
        "id": "stroma",
        "name": "Stroma",
        "synonyms": [],
        "colour": "#f59e0b",
        "allowedGeometries": [
          "polygon",
          "mask",
          "freehand"
        ]
      },
      {
        "id": "lymphocyte",
        "name": "Lymphocyte",
        "synonyms": [
          "TIL"
        ],
        "colour": "#3b82f6",
        "allowedGeometries": [
          "point",
          "polygon"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "modality",
        "license",
        "source"
      ],
      "oneModalityPerDataset": true,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {}
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

{
  "scripts": [
    {
      "when": "chest x-ray classification with five labels",
      "turns": [
        {
          "toolCalls": [
            {
              "name": "boot_studio",
              "arguments": {
                "intent": "chest x-ray classification",
                "name": "Chest X-ray classification",
                "patch": [
                  {
                    "op": "add",
                    "path": "/labels",
                    "value": [
                      {
                        "name": "finding",
                        "control": "Choices",
                        "classes": [
                          {
                            "id": "normal",
                            "name": "Normal"
                          },
                          {
                            "id": "pneumonia",
                            "name": "Pneumonia"
                          },
                          {
                            "id": "effusion",
                            "name": "Effusion"
                          },
                          {
                            "id": "cardiomegaly",
                            "name": "Cardiomegaly"
                          },
                          {
                            "id": "pneumothorax",
                            "name": "Pneumothorax"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "text": "Your chest X-ray Studio is open. Adding the five labels.",
          "toolCalls": [
            {
              "name": "patch_environment",
              "arguments": {
                "patch": [
                  {
                    "op": "add",
                    "path": "/labels",
                    "value": [
                      {
                        "name": "finding",
                        "control": "Choices",
                        "classes": [
                          {
                            "id": "normal",
                            "name": "Normal"
                          },
                          {
                            "id": "pneumonia",
                            "name": "Pneumonia"
                          },
                          {
                            "id": "effusion",
                            "name": "Effusion"
                          },
                          {
                            "id": "cardiomegaly",
                            "name": "Cardiomegaly"
                          },
                          {
                            "id": "pneumothorax",
                            "name": "Pneumothorax"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "summary": "Five classification labels"
              }
            }
          ]
        },
        {
          "text": "Done: five labels. Drop chest X-rays on the canvas to start."
        }
      ]
    },
    {
      "when": "<drop id=\"(drp-[a-z0-9]+)\"",
      "turns": [
        {
          "toolCalls": [
            {
              "name": "boot_studio",
              "arguments": {
                "dropId": "{{when.1}}",
                "preset": "preset:image-2d",
                "name": "Dropped images"
              }
            }
          ]
        },
        {
          "text": "Your Studio is open on the images; the rest join it as they're checked."
        }
      ]
    },
    {
      "turns": [
        {
          "text": "OK."
        }
      ]
    }
  ]
}

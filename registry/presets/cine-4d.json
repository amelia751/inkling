{
  "id": "cine-4d",
  "title": "4D cine",
  "description": "Cardiac cine MRI: spline contours and masks per slice and frame, copy-forward, ED/ES phases, function metrics; ACDC NIfTI export.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "cine-4d",
    "title": "4D cine",
    "data": {
      "kind": "studio.cine.dataKinds.volume-time"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.cine.renderers.slice-frame-canvas",
        "config": {
          "structures": {
            "rv": "right ventricle",
            "myo": "myocardium",
            "lv": "left ventricle"
          },
          "keyFrames": [
            {
              "id": "ED",
              "label": "End-diastole"
            },
            {
              "id": "ES",
              "label": "End-systole"
            }
          ]
        }
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.core.tools.pan",
      "studio.core.tools.windowLevel",
      "studio.overlay2d.tools.spline",
      "studio.overlay2d.tools.polygon",
      "studio.overlay2d.tools.freehand",
      "studio.overlay2d.tools.brush",
      "studio.overlay2d.tools.eraser"
    ],
    "exporters": [
      "studio.cine.exporters.acdc-nifti",
      "studio.cardiac-metrics.exporters.function-csv",
      "studio.cine.exporters.cine-contours-json"
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.cardiac-metrics.panels.metrics",
        "studio.core.panels.ai"
      ]
    },
    "reviewRules": [
      "studio.core.reviewRules.source-label-disagreement",
      "studio.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "lv-endo",
        "name": "LV endocardium",
        "synonyms": [
          "LV blood pool",
          "LVendo"
        ],
        "colour": "#ef4444",
        "allowedGeometries": [
          "polygon",
          "mask"
        ]
      },
      {
        "id": "lv-epi",
        "name": "LV epicardium",
        "synonyms": [
          "LVepi"
        ],
        "colour": "#22c55e",
        "allowedGeometries": [
          "polygon",
          "mask"
        ]
      },
      {
        "id": "rv-endo",
        "name": "RV endocardium",
        "synonyms": [
          "RV blood pool",
          "RVendo"
        ],
        "colour": "#3b82f6",
        "allowedGeometries": [
          "polygon",
          "mask"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "modality",
        "license",
        "source"
      ],
      "oneModalityPerDataset": true,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {
        "dicom.series-incomplete": "warn",
        "dicom.seg-frame-mismatch": "error",
        "nifti.orientation-mismatch": "warn"
      }
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

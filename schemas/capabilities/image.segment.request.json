{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SegmentRequest",
  "$defs": {
    "SegmentRequest": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "description": "Kernel asset id (or seed path in dev)"
        },
        "provider": {
          "type": "string"
        },
        "prompts": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "point"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "positive": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "box"
                  },
                  "box": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "XYXY pixels"
                  }
                },
                "required": [
                  "type",
                  "box"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "label": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "additionalProperties": false
    }
  },
  "$id": "studio://schema/capabilities/image.segment/request"
}

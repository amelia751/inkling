{
  "id": "generic-image",
  "title": "Generic image",
  "description": "Natural images (photos, scans, screenshots) on a light canvas renderer: boxes, polygons and keypoints with select / move / resize; COCO export. No Cornerstone, no window/level.",
  "spec": {
    "$schema": "studio://schema/environment/v1",
    "id": "generic-image",
    "title": "Generic image",
    "data": {
      "kind": "studio.image2d.dataKinds.raster"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "studio.image2d.renderers.canvas-raster"
      }
    ],
    "tools": [
      "studio.core.tools.select",
      "studio.core.tools.pan",
      "studio.overlay2d.tools.box",
      "studio.overlay2d.tools.polygon",
      "studio.overlay2d.tools.keypoint"
    ],
    "exporters": [
      "studio.image2d.exporters.coco"
    ],
    "panels": {
      "left": [
        "studio.core.panels.files",
        "studio.core.panels.labels"
      ],
      "right": [
        "studio.core.panels.ai"
      ]
    },
    "reviewRules": [
      "studio.core.reviewRules.source-label-disagreement",
      "studio.core.reviewRules.unlabeled-items"
    ],
    "overrides": [
      {
        "id": "studio.cornerstone.tools.cobb",
        "disabled": true
      }
    ],
    "layout": null
  },
  "rules": {
    "labels": [
      {
        "id": "object",
        "name": "Object",
        "synonyms": [
          "thing",
          "item"
        ],
        "colour": "#3b82f6",
        "allowedGeometries": [
          "box",
          "polygon",
          "point"
        ]
      }
    ],
    "layout": {
      "folderPatterns": [
        "**"
      ],
      "forbiddenCharacters": "<>:\"\\|?*",
      "maxDepth": 8
    },
    "datasets": {
      "requiredMetadata": [
        "license",
        "source"
      ],
      "oneModalityPerDataset": false,
      "uniqueNames": true
    },
    "annotations": {
      "insideImage": true,
      "requiredAttributes": []
    },
    "imaging": {
      "checks": {}
    },
    "severityOverrides": {},
    "merge": {
      "auto": "write-tier"
    }
  }
}

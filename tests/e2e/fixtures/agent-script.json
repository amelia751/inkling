{
  "scripts": [
    {
      "when": "mitosis",
      "turns": [
        {
          "text": "Let me look at the environment.",
          "toolCalls": [
            {
              "name": "get_environment"
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "patch_environment",
              "arguments": {
                "patch": [
                  {
                    "op": "add",
                    "path": "/labels/0/classes/-",
                    "value": {
                      "id": "mitosis",
                      "color": "#ff00aa"
                    }
                  }
                ],
                "summary": "Add a mitosis class"
              }
            }
          ]
        },
        {
          "text": "Added a mitosis class."
        }
      ]
    },
    {
      "when": "class names",
      "turns": [
        {
          "text": "That needs your OK first.",
          "toolCalls": [
            {
              "name": "run_command",
              "arguments": {
                "id": "inkling.wsi.commands.toggleClassNames"
              }
            }
          ]
        },
        {
          "text": "The command ran."
        }
      ]
    },
    {
      "when": "unannotated",
      "turns": [
        {
          "toolCalls": [
            {
              "name": "list_items",
              "arguments": {
                "filter": "unannotated"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "show_items",
              "arguments": {
                "title": "Unannotated slides",
                "itemIds": [
                  "TCGA-A6-5665"
                ]
              }
            }
          ]
        },
        {
          "text": "Here is the slide still to do."
        }
      ]
    },
    {
      "when": "add segmentation",
      "turns": [
        {
          "text": "Checking the registry.",
          "toolCalls": [
            {
              "name": "search_plugins",
              "arguments": {
                "capability": "image.segment"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "plan_plugin_change",
              "arguments": {
                "pluginId": "{{last.plugins.0.id}}"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "stage_plugin",
              "arguments": {
                "requestId": "{{last.requestId}}"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "request_install_approval",
              "arguments": {
                "requestId": "{{last.requestId}}"
              }
            }
          ]
        },
        {
          "text": "Segmentation is installed."
        }
      ]
    },
    {
      "when": "what did i import",
      "turns": [
        {
          "toolCalls": [
            {
              "name": "list_sources"
            }
          ]
        },
        {
          "text": "You imported one source with 20 images, in two folders: normal and pneumonia.",
          "toolCalls": [
            {
              "name": "open_location",
              "arguments": {
                "section": "sources",
                "nodeId": "{{last.sources.0.rootNodeId}}",
                "label": "Sources › 2d-xray"
              }
            }
          ]
        },
        {
          "text": "Open it to browse the files."
        }
      ]
    },
    {
      "when": "propose a link",
      "turns": [
        {
          "toolCalls": [
            {
              "name": "list_sources"
            }
          ]
        },
        {
          "text": "I'll propose it; nothing changes until you confirm.",
          "toolCalls": [
            {
              "name": "propose_relationship",
              "arguments": {
                "from": {
                  "nodeId": "{{last.sources.0.top.items.0.id}}"
                },
                "to": {
                  "nodeId": "{{last.sources.0.top.items.1.id}}",
                  "key": "folder name"
                },
                "rule": "Folder name is the label",
                "reason": "Both folders hold 10 images",
                "strength": "possible"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "confirm_proposal",
              "arguments": {
                "proposalId": "{{last.proposal.id}}"
              }
            }
          ]
        },
        {
          "text": "The API refused to let me confirm it (403): only you can confirm a proposal.",
          "toolCalls": [
            {
              "name": "open_location",
              "arguments": {
                "section": "explore",
                "tab": "relationships",
                "label": "Explore › Relationships"
              }
            }
          ]
        },
        {
          "text": "Confirm it there when you're ready."
        }
      ]
    }
  ]
}

# Environment-specific values for the gke/ai/app overlay, from `terraform output` of
# infra/terraform/ai and infra/terraform/phi (todo12 A7). Placeholders here; the real ones go in
# the git-ignored ../../live/ai/local.env
#   cp infra/k8s/overlays/gke/ai/app/local.env.example infra/k8s/overlays/gke/live/ai/local.env
# and `kubectl kustomize infra/k8s/overlays/gke/live/ai` renders with them. Never put project
# numbers or account emails here. Every key must be present in local.env too.

# ai data_services_cidr (the agent's Cloud SQL and Memorystore).
DATA_SERVICES_CIDR=10.60.0.0/16
# ai master_ipv4_cidr (Kubernetes API, for the GKE Sandbox provider).
CONTROL_PLANE_CIDR=172.16.1.0/28
# phi nat_egress_ip + /32 (web's proxy; the only caller of the agent).
PHI_EGRESS_CIDR=203.0.113.20/32
# ai redis_host (host:port).
REDIS_HOST=10.60.0.3:6378
# ai service account of the agent (Workload Identity; Vertex AI).
AGENT_SERVICE_ACCOUNT=studio-agent@spurby-ai.iam.gserviceaccount.com
# The agent's public host (DNS → ai ingress_ip) and spurby-phi's agent-only API host.
AGENT_HOST=agent.example.com
AGENT_API_URL=https://agent-api.example.com
# The AuthKit client id of this stage's WorkOS environment (not secret; the same as in
# spurby-phi's workos-secrets). The agent verifies people's access tokens with it (todo22 D2).
AGENT_WORKOS_CLIENT_ID=client_00000000000000000000000000

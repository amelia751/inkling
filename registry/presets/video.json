{
  "id": "video",
  "title": "Video",
  "description": "Video with tracked boxes, polygons and keypoints, segments and events; CVAT, MOT and temporal JSON export.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "video",
    "title": "Video",
    "data": {
      "kind": "inkling.video.dataKinds.video"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.video.renderers.frame-canvas"
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.overlay2d.tools.box",
      "inkling.overlay2d.tools.polygon",
      "inkling.overlay2d.tools.keypoint",
      "inkling.timeline.tools.segment",
      "inkling.timeline.tools.event"
    ],
    "exporters": [
      "inkling.video.exporters.cvat-video",
      "inkling.video.exporters.mot",
      "inkling.video.exporters.temporal-json"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels"
      ],
      "right": [
        "inkling.core.panels.ai"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.source-label-disagreement",
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  }
}

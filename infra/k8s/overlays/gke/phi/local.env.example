# Environment-specific values for the gke/phi overlay, from `terraform output` of
# infra/terraform/phi and infra/terraform/ai (todo12 A7). Not secret, but they change per
# environment: the real ones go in the git-ignored ../live/phi/local.env
#   cp infra/k8s/overlays/gke/phi/local.env.example infra/k8s/overlays/gke/live/phi/local.env
# and `kubectl kustomize infra/k8s/overlays/gke/live/phi` renders with them. This file holds
# placeholders (documentation ranges, example.com) so `kubectl kustomize
# infra/k8s/overlays/gke/phi` always renders. Never put project numbers or account emails here.
# Every key must be present in local.env too (a missing one fails the render).

# phi data_services_cidr (Cloud SQL and Memorystore, private services access).
DATA_SERVICES_CIDR=10.30.0.0/16
# ai nat_egress_ip + /32 (every request from the agent cluster).
AGENT_EGRESS_CIDR=203.0.113.10/32
# ai ingress_ip + /32 (the agent's public ingress; web's only egress).
AGENT_INGRESS_CIDR=203.0.113.11/32
# Who may reach the Studio host, comma-separated CIDRs. Kept until a WorkOS sign-in is verified
# on the live host (then removed); list only the operators' addresses. The placeholder admits nobody.
STUDIO_ALLOW_CIDRS=203.0.113.0/32
# phi redis_host (host:port; 6378 with TLS).
REDIS_HOST=10.30.0.3:6378
# phi buckets.objects, buckets.versioning-objects, buckets.versioning-manifests.
OBJECTS_BUCKET=spurby-phi-objects
VERSIONING_OBJECTS_BUCKET=spurby-phi-versioning-objects
VERSIONING_MANIFESTS_BUCKET=spurby-phi-versioning-manifests
# phi plugin_signing_key.
PLUGIN_SIGNING_KEY=projects/spurby-phi/locations/us-central1/keyRings/studio/cryptoKeys/plugin-signing/cryptoKeyVersions/1
# phi service_accounts.api, service_accounts.versioning, and from Milestone 3
# service_accounts.pipeline (used only when the pipeline-connectors component is on).
API_SERVICE_ACCOUNT=studio-api@spurby-phi.iam.gserviceaccount.com
VERSIONING_SERVICE_ACCOUNT=studio-versioning@spurby-phi.iam.gserviceaccount.com
PIPELINE_SERVICE_ACCOUNT=studio-pipeline@spurby-phi.iam.gserviceaccount.com
# phi pipeline_connector_subscription (Milestone 3).
PIPELINE_CONNECTOR_SUBSCRIPTION=projects/spurby-phi/subscriptions/pipeline-connector-objects
# Hosts (DNS: studio and agent-api → phi ingress_ip; agent → ai ingress_ip).
STUDIO_HOST=studio.example.com
AGENT_API_HOST=agent-api.example.com
AGENT_URL=https://agent.example.com

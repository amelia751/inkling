{
  "name": "@studio/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio agent runtime: pi harness + Daytona sandboxes, private HTTP/SSE service",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "smoke": "tsx scripts/smoke.ts",
    "sweep": "tsx scripts/sweep.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.227.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "3.1.0",
    "@hono/node-server": "2.1.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@studio/agent-protocol": "workspace:*",
    "@studio/contracts": "workspace:*",
    "@studio/observability-ts": "workspace:*",
    "@studio/plugin-ui-sdk": "workspace:*",
    "@studio/studio-tools": "workspace:*",
    "@workos-inc/node": "^12.1.0",
    "hono": "4.13.14",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}

{
  "id": "pathology",
  "title": "Whole-slide",
  "description": "Whole-slide images: vector regions, region brush and wand, cell counting, \u00b5m measurements; QuPath GeoJSON, ASAP XML and counts export.",
  "spec": {
    "$schema": "inkling://schema/environment/v1",
    "id": "pathology",
    "title": "Whole-slide",
    "data": {
      "kind": "inkling.wsi.dataKinds.raster-pyramid"
    },
    "viewports": [
      {
        "name": "main",
        "renderer": "inkling.wsi.renderers.osd"
      }
    ],
    "tools": [
      "inkling.core.tools.select",
      "inkling.core.tools.pan",
      "inkling.overlay2d.tools.box",
      "inkling.overlay2d.tools.ellipse",
      "inkling.overlay2d.tools.polygon",
      "inkling.overlay2d.tools.freehand",
      "inkling.overlay2d.tools.polyline",
      "inkling.wsi.tools.brush",
      "inkling.wsi.tools.eraser",
      "inkling.wsi.tools.wand",
      "inkling.wsi.tools.mark",
      "inkling.wsi.tools.length"
    ],
    "exporters": [
      "inkling.wsi.exporters.qupath-geojson",
      "inkling.wsi.exporters.asap-xml",
      "inkling.wsi.exporters.point-counts-csv"
    ],
    "panels": {
      "left": [
        "inkling.core.panels.files",
        "inkling.core.panels.labels"
      ],
      "right": [
        "inkling.core.panels.ai",
        "inkling.wsi.panels.counts"
      ],
      "viewport-bar": [
        "inkling.wsi.panels.adjust"
      ]
    },
    "reviewRules": [
      "inkling.core.reviewRules.source-label-disagreement",
      "inkling.core.reviewRules.unlabeled-items"
    ],
    "layout": null
  }
}

      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "type": "string",
          "enum": [
            "Labels",
            "RectangleLabels",
            "EllipseLabels",
            "PolygonLabels",
            "KeyPointLabels",
            "BrushLabels",
            "TimeSeriesLabels",
            "VideoRectangle",
            "Choices",
            "SpanLabels",
            "RowLabels"
          ],
          "description": "Label control id, e.g. Labels, RectangleLabels, PolygonLabels, Choices"
        },
        "toName": {
          "description": "Viewport name this group labels; defaults to the first viewport",

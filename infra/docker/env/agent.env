# apps/agent in the compose full stack. Non-secret dev placeholders only (see README.md).
# development, not production: STUDIO_AGENT_MODEL=scripted is refused in production.
STUDIO_ENV=development
STUDIO_AGENT_HOST=0.0.0.0
STUDIO_AGENT_PORT=8100
STUDIO_AGENT_MODEL=scripted
STUDIO_AGENT_SANDBOX=off
STUDIO_AGENT_STORE=postgres
STUDIO_AGENT_DATABASE_URL=postgres://studio:dev-only-pg-password@postgres:5432/agent
STUDIO_AGENT_AUTO_MIGRATE=true
STUDIO_AGENT_EVENT_BUS=redis
STUDIO_AGENT_REDIS_URL=redis://redis:6379/1
STUDIO_AGENT_SWEEPER_ENABLED=false
STUDIO_API_URL=http://api:8000
STUDIO_WEB_URL=http://router:8080
STUDIO_AGENT_DATA_DIR=/tmp/agent
STUDIO_AGENT_TOKEN=dev-only-agent-service-token
# Sign-in (todo9 Phase 5): `workos` also needs STUDIO_AGENT_WORKOS_CLIENT_ID (client_emulated),
# STUDIO_AGENT_WORKOS_BASE_URL (http://workos-emulate:4100) and the same ISSUER as the api.
STUDIO_AGENT_AUTH_MODE=dev
STUDIO_AGENT_APPROVAL_SECRET=dev-only-approval-secret

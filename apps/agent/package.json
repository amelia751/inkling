{
  "name": "@inkling/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inkling agent runtime: pi harness + Daytona sandboxes, private HTTP/SSE service",
  "exports": {
    "./protocol": "./src/protocol.ts"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "smoke": "tsx scripts/smoke.ts",
    "sweep": "tsx scripts/sweep.ts",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.227.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}

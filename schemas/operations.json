          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "parentId",
          "name"
        ]
      }
    },
    {
      "id": "source.rename",
      "tool": "source_rename",
      "tier": "write",
      "method": "POST",
      "path": "/projects/{pid}/fs/ops",
      "description": "Rename a file or folder.",
